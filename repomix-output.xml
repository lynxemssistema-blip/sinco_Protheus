                                                    />
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </section>

                    {/* 3. Support Activities */}
                    <section>
                        <h3 className="text-md font-bold text-gray-800 mb-4 flex items-center gap-2">
                            <CheckSquare className="h-4 w-4 text-gray-600" />

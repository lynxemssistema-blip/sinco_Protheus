import React, { useState, useRef, useEffect } from 'react';
import { X, Bot, Send, Loader2, ChevronDown, ChevronUp, Database, CheckCircle2, AlertCircle, Cpu } from 'lucide-react';
import { useAuth } from '../contexts/AuthContext';
import DOMPurify from 'dompurify';
// ── Inline Markdown renderer ──────────────────────────────────────────────────
function renderInline(text) {
    return text
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`(.+?)`/g, '<code class="bg-slate-100 px-1 py-0.5 rounded text-xs font-mono text-blue-700">$1</code>');
}

function RenderMarkdown({ text }) {
    if (!text) return null;
    const lines = text.split('\n');
    return (
        <div className="prose prose-sm max-w-none text-slate-800 space-y-1">
            {lines.map((line, i) => {
                if (line.startsWith('### ')) return <h3 key={i} className="text-sm font-bold text-slate-900 mt-3 mb-1">{line.slice(4)}</h3>;
                if (line.startsWith('## ')) return <h2 key={i} className="text-base font-bold text-blue-800 mt-4 mb-1 border-b border-blue-100 pb-1">{line.slice(3)}</h2>;
                if (line.startsWith('# ')) return <h1 key={i} className="text-lg font-bold text-blue-900 mt-4 mb-2">{line.slice(2)}</h1>;
                if (line.startsWith('- ') || line.startsWith('* '))
                    return <div key={i} className="flex gap-2 text-sm"><span className="text-blue-500 mt-0.5">•</span><span dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(renderInline(line.slice(2))) }} /></div>;
                if (/^\d+\./.test(line))
                    return <div key={i} className="flex gap-2 text-sm"><span className="text-blue-500 font-bold min-w-[16px]">{line.match(/^\d+/)[0]}.</span><span dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(renderInline(line.replace(/^\d+\.\s*/, ''))) }} /></div>;
                if (line.startsWith('```')) return null;
                if (!line.trim()) return <div key={i} className="h-1" />;
                return <p key={i} className="text-sm leading-relaxed" dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(renderInline(line)) }} />;
            })}
        </div>
    );
}

// ── Live Reasoning Panel ──────────────────────────────────────────────────────
function ReasoningPanel({ steps }) {
    const [expanded, setExpanded] = useState(true);
    if (!steps || steps.length === 0) return null;

    const isDone = steps.some(s => s.type === 'done');
    const hasError = steps.some(s => s.type === 'error');

    return (
        <div className={`border rounded-xl overflow-hidden text-xs transition-all ${hasError ? 'border-red-200 bg-red-50' :
            isDone ? 'border-emerald-200 bg-emerald-50' :
                'border-blue-200 bg-blue-50'
            }`}>
            <button onClick={() => setExpanded(v => !v)}
                className="w-full flex items-center gap-2 px-3 py-2 text-left">
                {isDone
                    ? <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600 shrink-0" />
                    : hasError
                        ? <AlertCircle className="w-3.5 h-3.5 text-red-500 shrink-0" />
                        : <Loader2 className="w-3.5 h-3.5 text-blue-600 animate-spin shrink-0" />
                }
                <span className={`font-semibold flex-1 ${isDone ? 'text-emerald-700' : hasError ? 'text-red-700' : 'text-blue-700'}`}>
                    {isDone ? 'Raciocínio concluído' : hasError ? 'Erro no processo' : 'Raciocinando...'}
                </span>
                <span className="text-slate-400">{steps.length} etapa(s)</span>
                {expanded ? <ChevronUp className="w-3 h-3 text-slate-400" /> : <ChevronDown className="w-3 h-3 text-slate-400" />}
            </button>

            {expanded && (
                <div className="border-t border-slate-200 divide-y divide-slate-100">
                    {steps.map((step, i) => (
                        <div key={i} className="flex items-start gap-2 px-3 py-1.5">
                            <span className="shrink-0 mt-0.5 text-base leading-none">{step.icon || '▶'}</span>
                            <span className="text-slate-700 flex-1"
                                dangerouslySetInnerHTML={{ __html: DOMPurify.sanitize(renderInline(step.message || '')) }} />
                        </div>
                    ))}
                    {!isDone && !hasError && (
                        <div className="px-3 py-1.5 flex items-center gap-2">
                            <span className="inline-block w-2 h-3 bg-blue-500 animate-pulse rounded-sm" />
                            <span className="text-slate-400">aguardando resposta...</span>
                        </div>
                    )}
                </div>
            )}
        </div>
    );
}

// ── Persistent history helpers (localStorage per user+context) ────────────────
const HISTORY_KEY = (userId, pedido) => `pcpmetal_hist_${userId}_${pedido || 'global'}`;
const MAX_STORED_TURNS = 20;

function loadHistory(userId, pedido) {
    try {
        const raw = localStorage.getItem(HISTORY_KEY(userId, pedido));
        return raw ? JSON.parse(raw) : [];
    } catch { return []; }
}

function saveHistory(userId, pedido, turns) {
    try {
        localStorage.setItem(HISTORY_KEY(userId, pedido), JSON.stringify(turns.slice(-MAX_STORED_TURNS)));
    } catch { /* localStorage full */ }
}

const QUICK_PROMPTS = [
    'Qual o status de fabricação?',
    'Há risco de atraso na entrega?',
    'Quantas peças faltam para entrega?',
    'Qual a estratégia para cumprir o prazo?',
];

// ── Main Drawer ───────────────────────────────────────────────────────────────
const PCPMetalDrawer = ({ isOpen, onClose, context = {} }) => {
    const { user } = useAuth();
    const userId = user?.idUsuario || user?.id;

    const [messages, setMessages] = useState([]);
    // historico = lightweight [{role:'user'|'agent', text}] for Gemini context
    const [historico, setHistorico] = useState([]);
    const [input, setInput] = useState('');
    const [loading, setLoading] = useState(false);
    const [showSQL, setShowSQL] = useState({});
    const bottomRef = useRef(null);
    const abortRef = useRef(null);

    // Load persistent history when drawer opens / context changes
    useEffect(() => {
        if (!isOpen) return;

        const stored = loadHistory(userId, context.pedido);

        if (stored.length > 0) {
            // Rebuild UI messages from stored turns
            const rebuilt = [];
            if (context.pedido || context.cliente) {
                const parts = [];
                if (context.pedido) parts.push(`Pedido **${context.pedido.trim()}**`);
                if (context.cliente) parts.push(`Cliente **${context.cliente.trim()}**`);
                rebuilt.push({ role: 'system', text: `📋 Contexto: ${parts.join(' | ')}\n\n_Continuando conversa anterior — ${stored.length} mensagem(s) no histórico._` });
            }
            for (const t of stored) {
                rebuilt.push({ role: t.role === 'user' ? 'user' : 'agent', text: t.text, sqlsExecuted: t.sqlsExecuted });
            }
            setMessages(rebuilt);
            setHistorico(stored.map(t => ({ role: t.role, text: t.text })));
        } else {
            // Fresh conversation
            const parts = [];
            if (context.pedido) parts.push(`Pedido **${context.pedido.trim()}**`);
            if (context.item) parts.push(`Item **${context.item}**`);
            if (context.cliente) parts.push(`Cliente **${context.cliente.trim()}**`);
            if (context.produto) parts.push(`Produto **${context.produto}**`);

            const greeting = parts.length > 0
                ? `📋 Contexto carregado: ${parts.join(' | ')}\n\nFaça sua pergunta sobre este pedido ou qualquer análise de produção.`
                : '👋 Olá! Sou o **PCPMetal**, seu assistente de PCP.\n\nPosso analisar pedidos, verificar produção, calcular saldos e sugerir estratégias. Como posso ajudar?';

            setMessages([{ role: 'system', text: greeting }]);
            setHistorico([]);
        }
        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [isOpen, context.pedido, userId]);

    useEffect(() => {
        bottomRef.current?.scrollIntoView({ behavior: 'smooth' });
    }, [messages]);

    // Cancel any ongoing stream on unmount / close
    useEffect(() => {
        if (!isOpen && abortRef.current) abortRef.current.abort();
    }, [isOpen]);

    const handleSend = async () => {
        if (!input.trim() || loading) return;
        const question = input.trim();
        setInput('');

        // Append user message to UI and history
        setMessages(prev => [...prev, { role: 'user', text: question }]);
        const newHistorico = [...historico, { role: 'user', text: question }];
        setHistorico(newHistorico);
        setLoading(true);

        const thinkMsgId = `think-${Date.now()}`;
        setMessages(prev => [...prev, { role: 'thinking', id: thinkMsgId, steps: [] }]);

        const controller = new AbortController();
        abortRef.current = controller;

        try {
            const response = await fetch('/api/pcpmetal/ask-stream', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${localStorage.getItem('token') || ''}`,
                },
                body: JSON.stringify({
                    pergunta: question,
                    pedido: context.pedido || null,
                    item: context.item || null,
                    cliente: context.cliente || null,
                    produto: context.produto || null,
                    userId,
                    // send last 6 turns as context (text only to save tokens)
                    historico: newHistorico.slice(-6).map(h => ({ role: h.role, text: h.text.slice(0, 800) })),
                }),
                signal: controller.signal,
            });

            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop(); // keep incomplete line

                for (const line of lines) {
                    if (!line.startsWith('data: ')) continue;
                    try {
                        const data = JSON.parse(line.slice(6));

                        if (data.type === 'result') {
                            const agentMsg = {
                                role: 'agent',
                                text: data.answer,
                                sqlsExecuted: data.sqlsExecuted || []
                            };
                            setMessages(prev => [
                                ...prev.filter(m => m.id !== thinkMsgId),
                                agentMsg
                            ]);

                            // Persist full history including this answer
                            const fullHistory = [
                                ...newHistorico,
                                { role: 'agent', text: data.answer, sqlsExecuted: data.sqlsExecuted }
                            ];
                            setHistorico(fullHistory);
                            saveHistory(userId, context.pedido, fullHistory);
                            setLoading(false);
                            continue;
                        }

                        if (data.type === 'error') {
                            setMessages(prev => [
                                ...prev.filter(m => m.id !== thinkMsgId),
                                { role: 'error', text: `❌ ${data.message}` }
                            ]);
                            setLoading(false);
                            continue;
                        }

                        // Step events — append to thinking bubble
                        setMessages(prev => prev.map(m =>
                            m.id === thinkMsgId
                                ? { ...m, steps: [...(m.steps || []), data] }
                                : m
                        ));
                    } catch (_) { /* malformed JSON line */ }
                }
            }
        } catch (err) {
            if (err.name !== 'AbortError') {
                setMessages(prev => [
                    ...prev.filter(m => m.id !== thinkMsgId),
                    { role: 'error', text: `❌ Erro de conexão: ${err.message}` }
                ]);
            }
            setLoading(false);
        }
    };

    const handleClearHistory = () => {
        if (!window.confirm('Limpar todo o histórico desta conversa?')) return;
        saveHistory(userId, context.pedido, []);
        setHistorico([]);
        const parts = [];
        if (context.pedido) parts.push(`Pedido **${context.pedido.trim()}**`);
        if (context.cliente) parts.push(`Cliente **${context.cliente.trim()}**`);
        setMessages([{ role: 'system', text: parts.length > 0 ? `📋 Contexto: ${parts.join(' | ')}\n\nHistórico limpo. Nova conversa iniciada.` : '👋 Nova conversa iniciada.' }]);
    };

    if (!isOpen) return null;

    const histCount = historico.filter(h => h.role === 'user').length;

    return (
        <div className="fixed inset-0 z-[200] flex items-stretch justify-end pointer-events-none">
            {/* Backdrop */}
            <div className="absolute inset-0 bg-slate-900/40 backdrop-blur-sm pointer-events-auto" onClick={onClose} />

            {/* Drawer */}
            <div className="relative w-full max-w-xl h-full bg-white shadow-2xl flex flex-col pointer-events-auto animate-in slide-in-from-right duration-300">

                {/* Header */}
                <div className="flex items-center justify-between p-4 bg-gradient-to-r from-blue-700 to-blue-900 text-white shrink-0">
                    <div className="flex items-center gap-3">
                        <div className="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                            <Bot className="w-6 h-6" />
                        </div>
                        <div>
                            <h2 className="font-bold text-base flex items-center gap-2">
                                PCPMetal AI
                                <span className="text-[10px] bg-white/20 px-2 py-0.5 rounded-full font-normal">gemini-2.5</span>
                            </h2>
                            <p className="text-xs opacity-70">
                                {histCount > 0 ? `${histCount} pergunta(s) no histórico` : 'Nova conversa'}
                                {context.pedido && ` · Pedido ${context.pedido.trim()}`}
                            </p>
                        </div>
                    </div>
                    <div className="flex items-center gap-1">
                        {histCount > 0 && (
                            <button
                                onClick={handleClearHistory}
                                title="Limpar histórico"
                                className="text-[10px] px-2 py-1 rounded-lg bg-white/10 hover:bg-white/20 transition-colors"
                            >
                                Limpar
                            </button>
                        )}
                        <button onClick={onClose} className="p-2 hover:bg-white/10 rounded-lg transition-colors ml-1">
                            <X className="w-5 h-5" />
                        </button>
                    </div>
                </div>

                {/* Messages */}
                <div className="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50">
                    {messages.map((msg, idx) => (
                        <div key={msg.id || idx}>

                            {msg.role === 'system' && (
                                <div className="bg-blue-50 border border-blue-100 rounded-xl p-3">
                                    <RenderMarkdown text={msg.text} />
                                </div>
                            )}

                            {msg.role === 'user' && (
                                <div className="flex justify-end">
                                    <div className="max-w-[85%] bg-blue-600 text-white rounded-2xl rounded-tr-sm px-4 py-3">
                                        <p className="text-sm">{msg.text}</p>
                                    </div>
                                </div>
                            )}

                            {msg.role === 'thinking' && (
                                <div className="flex gap-2">
                                    <div className="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center shrink-0 mt-1">
                                        <Cpu className="w-4 h-4 text-white animate-pulse" />
                                    </div>
                                    <div className="flex-1">
                                        <ReasoningPanel steps={msg.steps} />
                                    </div>
                                </div>
                            )}

                            {msg.role === 'agent' && (
                                <div className="flex gap-2">
                                    <div className="w-7 h-7 rounded-full bg-blue-700 flex items-center justify-center shrink-0 mt-1">
                                        <Bot className="w-4 h-4 text-white" />
                                    </div>
                                    <div className="flex-1 bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-3 shadow-sm">
                                        <RenderMarkdown text={msg.text} />
                                        {msg.sqlsExecuted?.length > 0 && (
                                            <div className="mt-3 pt-3 border-t border-slate-100">
                                                <button
                                                    className="flex items-center gap-1.5 text-[10px] text-slate-400 hover:text-slate-600"
                                                    onClick={() => setShowSQL(p => ({ ...p, [idx]: !p[idx] }))}
                                                >
                                                    <Database className="w-3 h-3" />
                                                    {msg.sqlsExecuted.length} consulta(s) executada(s)
                                                    {showSQL[idx] ? <ChevronUp className="w-3 h-3" /> : <ChevronDown className="w-3 h-3" />}
                                                </button>
                                                {showSQL[idx] && (
                                                    <div className="mt-2 space-y-1">
                                                        {msg.sqlsExecuted.map((s, si) => (
                                                            <div key={si} className="bg-slate-900 text-emerald-400 text-[10px] font-mono p-2 rounded-lg overflow-x-auto">
                                                                <span className="text-slate-400 uppercase text-[8px] tracking-wider">[{s.banco}] </span>
                                                                {s.sql}
                                                                {s.error && <span className="text-red-400 block mt-1">Erro: {s.error}</span>}
                                                                {s.rowCount !== undefined && !s.error && <span className="text-slate-500 block mt-1">{s.rowCount} linha(s)</span>}
                                                            </div>
                                                        ))}
                                                    </div>
                                                )}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            )}

                            {msg.role === 'error' && (
                                <div className="bg-red-50 border border-red-200 text-red-700 rounded-xl p-3 text-sm">
                                    {msg.text}
                                </div>
                            )}
                        </div>
                    ))}
                    <div ref={bottomRef} />
                </div>

                {/* Quick Prompts */}
                {historico.length === 0 && (
                    <div className="px-4 py-2 bg-white border-t border-slate-100 shrink-0">
                        <p className="text-[10px] text-slate-400 uppercase font-bold mb-2">Sugestões:</p>
                        <div className="flex flex-wrap gap-1.5">
                            {QUICK_PROMPTS.map(q => (
                                <button key={q} onClick={() => setInput(q)}
                                    className="text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 px-3 py-1 rounded-full transition-colors">
                                    {q}
                                </button>
                            ))}
                        </div>
                    </div>
                )}

                {/* Input */}
                <div className="p-4 bg-white border-t border-slate-200 shrink-0">
                    <div className="flex gap-2">
                        <textarea
                            className="flex-1 bg-slate-100 rounded-xl px-4 py-3 text-sm outline-none resize-none focus:ring-2 focus:ring-blue-500 min-h-[160px] max-h-64"
                            placeholder="Pergunte ao PCPMetal... (Enter para enviar)"
                            rows={10}
                            value={input}
                            onChange={e => setInput(e.target.value)}
                            onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); } }}
                        />
                        <button
                            onClick={handleSend}
                            disabled={loading || !input.trim()}
                            className="w-12 h-12 rounded-xl bg-blue-700 flex items-center justify-center text-white hover:bg-blue-800 transition-all disabled:opacity-40 active:scale-95"
                        >
                            {loading ? <Loader2 className="w-5 h-5 animate-spin" /> : <Send className="w-5 h-5" />}
                        </button>
                    </div>
                    <p className="text-[10px] text-slate-400 mt-2 text-center">
                        Histórico salvo automaticamente · Shift+Enter para nova linha
                    </p>
                </div>
            </div>
        </div>
    );
};

export default PCPMetalDrawer;
</file>

<file path="client/src/components/ProductDocuments.jsx">
import React, { useState, useEffect } from 'react';
import { FileText, Link as LinkIcon, Plus, Trash2, ExternalLink } from 'lucide-react';
import api, { getProductDocuments, getFileUrl } from '../services/api';

// Componente deve ser inserido na página de Estrutura ou Detalhe
const ProductDocuments = ({ produtoCodigo }) => {
    const [docs, setDocs] = useState([]);
    const [loading, setLoading] = useState(false);

    // Form states
    const [isAdding, setIsAdding] = useState(false);
    const [newDoc, setNewDoc] = useState({ titulo: '', url_arquivo: '', tipo: 'Desenho' });

    const fetchDocs = async () => {
        setLoading(true);
        try {
            const data = await getProductDocuments(produtoCodigo);
            setDocs(data);
        } catch (error) {
            console.error("Erro ao carregar documentos:", error);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        if (produtoCodigo) fetchDocs();
    }, [produtoCodigo]);

    const handleSubmit = async (e) => {
        e.preventDefault();
        try {
            await api.post('/docs', {
                produto_codigo: produtoCodigo,
                ...newDoc
            });
            setNewDoc({ titulo: '', url_arquivo: '', tipo: 'Desenho' });
            setIsAdding(false);
            fetchDocs();
        } catch (error) {
            alert('Erro ao salvar documento. Verifique o console.');
        }
    };

    const handleDelete = async (id) => {
        if (!confirm('Tem certeza que deseja remover este link?')) return;
        try {
            await api.delete(`/docs/${id}`);
            fetchDocs();
        } catch (error) {
            alert('Erro ao excluir.');
        }
    };

    return (
        <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mt-6">
            <div className="flex items-center justify-between mb-4">
                <div className="flex items-center gap-2">
                    <FileText className="h-5 w-5 text-blue-600" />
                    <h3 className="text-lg font-bold text-gray-800">Documentos & Arquivos</h3>
                </div>
                {!isAdding && (
                    <button
                        onClick={() => setIsAdding(true)}
                        className="flex items-center gap-1 text-sm text-blue-600 hover:bg-blue-50 px-3 py-1.5 rounded-lg transition-colors font-medium border border-transparent hover:border-blue-100"
                    >
                        <Plus className="h-4 w-4" />
                        Adicionar Link
                    </button>
                )}
            </div>

            {/* Form de Adição */}
            {isAdding && (
                <form onSubmit={handleSubmit} className="bg-gray-50 p-4 rounded-lg mb-4 border border-blue-100 animate-fadeIn">
                    <div className="grid grid-cols-1 md:grid-cols-12 gap-3 mb-3">
                        <div className="md:col-span-3">
                            <label className="block text-xs font-semibold text-gray-500 mb-1">Tipo</label>
                            <select
                                value={newDoc.tipo}
                                onChange={e => setNewDoc({ ...newDoc, tipo: e.target.value })}
                                className="w-full rounded border-gray-300 p-2 text-sm focus:border-blue-500 outline-none bg-white"
                            >
                                <option value="Desenho">Desenho 📐</option>
                                <option value="Manual">Manual 📖</option>
                                <option value="Datasheet">Datasheet 📊</option>
                                <option value="Outro">Outro 📎</option>
                            </select>
                        </div>
                        <div className="md:col-span-4">
                            <label className="block text-xs font-semibold text-gray-500 mb-1">Título do Documento</label>
                            <input
                                type="text"
                                placeholder="Ex: Manual Técnico, Datasheet..."
                                value={newDoc.titulo}
                                onChange={e => setNewDoc({ ...newDoc, titulo: e.target.value })}
                                className="w-full rounded border-gray-300 p-2 text-sm focus:border-blue-500 outline-none"
                                required
                            />
                        </div>
                        <div className="md:col-span-5">
                            <label className="block text-xs font-semibold text-gray-500 mb-1">Link / Caminho do Arquivo</label>
                            <input
                                type="text"
                                placeholder="C:\Docs\manual.pdf ou https://..."
                                value={newDoc.url_arquivo}
                                onChange={e => setNewDoc({ ...newDoc, url_arquivo: e.target.value })}
                                className="w-full rounded border-gray-300 p-2 text-sm focus:border-blue-500 outline-none"
                                required
                            />
                        </div>
                    </div>
                    <div className="flex justify-end gap-2">
                        <button
                            type="button"
                            onClick={() => setIsAdding(false)}
                            className="text-gray-500 hover:text-gray-700 text-sm px-3 py-1"
                        >
                            Cancelar
                        </button>
                        <button
                            type="submit"
                            className="bg-blue-600 text-white text-sm px-4 py-1.5 rounded hover:bg-blue-700 transition-colors"
                        >
                            Salvar Link
                        </button>
                    </div>
                </form>
            )}

            {/* Lista */}
            {loading ? (
                <div className="flex justify-center py-4">
                    <div className="h-5 w-5 animate-spin rounded-full border-2 border-blue-600 border-t-transparent"></div>
                </div>
            ) : docs.length === 0 ? (
                <div className="text-center py-6 text-gray-400 text-sm bg-gray-50/50 rounded-lg border border-dashed border-gray-200">
                    Nenhum documento associado.
                </div>
            ) : (
                <div className="space-y-2">
                    {docs.map(doc => (
                        <div key={doc.id} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-white hover:shadow-sm border border-transparent hover:border-gray-200 transition-all group">
                            <div className="flex items-center gap-3 overflow-hidden">
                                <div className={`p-2 rounded border border-gray-200 ${doc.tipo === 'Desenho' ? 'bg-blue-50 text-blue-600' :
                                    doc.tipo === 'Manual' ? 'bg-indigo-50 text-indigo-600' :
                                        'bg-white text-gray-500'
                                    }`}>
                                    <FileText className="h-4 w-4" />
                                </div>
                                <div className="min-w-0">
                                    <div className="flex items-center gap-2">
                                        <h4 className="font-medium text-gray-800 truncate">{doc.titulo}</h4>
                                        {doc.tipo && (
                                            <span className={`text-[10px] px-1.5 py-0.5 rounded border uppercase font-bold tracking-wider ${doc.tipo === 'Desenho' ? 'bg-blue-100 text-blue-700 border-blue-200' :
                                                doc.tipo === 'Manual' ? 'bg-indigo-100 text-indigo-700 border-indigo-200' :
                                                    'bg-gray-100 text-gray-600 border-gray-200'
                                                }`}>
                                                {doc.tipo}
                                            </span>
                                        )}
                                    </div>
                                    <div className="flex items-center gap-2">
                                        <a
                                            href={getFileUrl(`/api/docs/view?path=${encodeURIComponent(doc.url_arquivo)}`)}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            className="text-xs text-blue-600 hover:underline flex items-center gap-1 truncate font-medium bg-blue-50 px-2 py-1 rounded"
                                        >
                                            <ExternalLink className="h-3 w-3" />
                                            Abrir Arquivo
                                        </a>
                                        <span className="text-xs text-gray-400 truncate max-w-[200px]" title={doc.url_arquivo}>
                                            {doc.url_arquivo}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <button
                                onClick={() => handleDelete(doc.id)}
                                className="opacity-0 group-hover:opacity-100 p-2 text-gray-400 hover:text-red-600 transition-all"
                                title="Remover"
                            >
                                <Trash2 className="h-4 w-4" />
                            </button>
                        </div>
                    ))}
                </div>
            )}
        </div>
    );
};

export default ProductDocuments;
</file>

<file path="client/src/components/ProductionHistoryModal.jsx">
import { useState, useEffect, useRef } from 'react';
import { X, ClipboardList, Clock, User, CheckCircle, XCircle, AlertTriangle, Camera, ImagePlus, Trash2 } from 'lucide-react';
import { getAppointmentHistory, submitConferencia } from '../services/api';

export default function ProductionHistoryModal({ opData, onClose }) {
    const [history, setHistory] = useState([]);
    const [loading, setLoading] = useState(true);
    const [loggedUser, setLoggedUser] = useState(null);

    // Modal de recusa
    const [recusaModal, setRecusaModal] = useState(null); // { id }
    const [motivoRecusa, setMotivoRecusa] = useState('');
    const [fotosRecusa, setFotosRecusa] = useState([]);
    const [fotosPreview, setFotosPreview] = useState([]);
    const fotoInputRef = useRef(null);
    const [savingId, setSavingId] = useState(null);
    const [toast, setToast] = useState(null);

    useEffect(() => {
        const userStr = localStorage.getItem('@MetalFisa:user');
        if (userStr) {
            try { setLoggedUser(JSON.parse(userStr)); } catch (e) { }
        }
        if (opData) fetchHistory();
    }, [opData]);

    const fetchHistory = async () => {
        setLoading(true);
        try {
            const data = await getAppointmentHistory(opData.op, opData.item_op, opData.sequen, opData.operacao);
            setHistory(data || []);
        } catch (err) {
            console.error('Error fetching history:', err);
        } finally {
            setLoading(false);
        }
    };

    const showToast = (msg, type = 'success') => {
        setToast({ msg, type });
        setTimeout(() => setToast(null), 3000);
    };

    const handleConferencia = async (id, status, observacao = '', fotos = []) => {
        if (!loggedUser) return;
        setSavingId(id);
        try {
            await submitConferencia({
                id, status, observacao, fotos,
                conferido_por: loggedUser.NomeCompleto || loggedUser.Login || 'Conferente'
            });
            showToast(status === 'OK' ? 'Apontamento aprovado!' : 'Apontamento recusado!', status === 'OK' ? 'success' : 'error');
            fetchHistory();
        } catch (err) {
            console.error('Erro ao registrar conferência', err);
            showToast('Erro ao registrar conferência. Tente novamente.', 'error');
        } finally {
            setSavingId(null);
        }
    };

    const handleRecusar = (id) => {
        setMotivoRecusa('');
        setFotosRecusa([]);
        setFotosPreview([]);
        setRecusaModal({ id });
    };

    const handleFotosChange = (e) => {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        const novos = [...fotosRecusa, ...files].slice(0, 5);
        setFotosRecusa(novos);
        setFotosPreview(novos.map(f => URL.createObjectURL(f)));
    };

    const removerFoto = (idx) => {
        const novos = fotosRecusa.filter((_, i) => i !== idx);
        setFotosRecusa(novos);
        setFotosPreview(novos.map(f => URL.createObjectURL(f)));
    };

    const confirmRecusa = async () => {
        if (!motivoRecusa.trim()) return;
        await handleConferencia(recusaModal.id, 'DIVERGENTE', motivoRecusa.trim(), fotosRecusa);
        setRecusaModal(null);
    };

    if (!opData) return null;

    const canConferir = loggedUser && ['A', 'C'].includes(loggedUser.TipoUsuario);

    const fmtDate = (d) => {
        if (!d) return '-';
        const dt = new Date(d);
        return isNaN(dt) ? '-' : dt.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit' });
    };
    const fmtTime = (d) => {
        if (!d) return '-';
        const dt = new Date(d);
        return isNaN(dt) ? '-' : dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    };
    const calcDuration = (start, end) => {
        if (!start || !end) return '-';
        const ms = new Date(end).getTime() - new Date(start).getTime();
        if (isNaN(ms) || ms < 0) return '-';
        const totalMin = Math.floor(ms / 60000);
        const h = Math.floor(totalMin / 60);
        const m = totalMin % 60;
        return h > 0 ? `${h}h${String(m).padStart(2, '0')}min` : `${m}min`;
    };

    const totalQty = history.reduce((acc, r) => acc + Number(r.quantidade || 0), 0);
    const totalMs = history.reduce((acc, r) => {
        if (!r.data_inicio || !r.data_fim) return acc;
        const ms = new Date(r.data_fim).getTime() - new Date(r.data_inicio).getTime();
        return acc + (isNaN(ms) ? 0 : Math.max(0, ms));
    }, 0);
    const totalH = Math.floor(totalMs / 3600000);
    const totalM = Math.floor((totalMs % 3600000) / 60000);

    return (
        <>
            <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
                <div className="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col">
                    {/* Header */}
                    <div className="p-4 border-b flex justify-between items-center bg-slate-50 rounded-t-xl">
                        <div>
                            <h3 className="font-bold text-slate-800 flex items-center gap-2 text-lg">
                                <ClipboardList className="w-5 h-5 text-blue-600" />
                                Histórico de Apontamentos
                            </h3>
                            <div className="text-xs text-slate-500 mt-1 flex flex-wrap gap-3">
                                <span>OP: <strong>{opData.op}</strong></span>
                                <span>Item: <strong>{opData.item_op}</strong></span>
                                <span>Seq: <strong>{opData.sequen}</strong></span>
                                <span>Oper: <strong>{opData.operacao}</strong> ({opData.desc_operacao})</span>
                                {opData.desc_produto && <span>Produto: <strong>{opData.desc_produto}</strong></span>}
                            </div>
                        </div>
                        <button onClick={onClose} className="p-1 hover:bg-red-100 rounded-full transition">
                            <X className="w-5 h-5 text-slate-400 hover:text-red-500" />
                        </button>
                    </div>

                    {/* Body */}
                    <div className="flex-1 overflow-y-auto">
                        {loading ? (
                            <div className="flex justify-center items-center h-40">
                                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                            </div>
                        ) : history.length === 0 ? (
                            <div className="text-center py-12 text-slate-400">
                                Nenhum apontamento registrado para esta operação.
                            </div>
                        ) : (
                            <table className="w-full text-sm text-left">
                                <thead className="bg-slate-50 text-slate-600 font-medium sticky top-0 shadow-sm text-xs">
                                    <tr>
                                        <th className="px-4 py-3">#</th>
                                        <th className="px-4 py-3">Data</th>
                                        <th className="px-4 py-3">Início</th>
                                        <th className="px-4 py-3">Fim</th>
                                        <th className="px-4 py-3">Duração</th>
                                        <th className="px-4 py-3">Qtd</th>
                                        <th className="px-4 py-3">Usuário</th>
                                        <th className="px-4 py-3">Conferência</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-slate-100">
                                    {history.map((record, idx) => {
                                        const isSaving = savingId === record.id;
                                        return (
                                            <tr key={record.id || idx} className="hover:bg-slate-50 transition-colors">
                                                <td className="px-4 py-2.5 text-slate-400 text-xs">{idx + 1}</td>
                                                <td className="px-4 py-2.5 font-mono text-xs text-slate-600">
                                                    {fmtDate(record.data_inicio || record.criado_em)}
                                                </td>
                                                <td className="px-4 py-2.5 font-mono text-xs text-slate-700">
                                                    <div className="flex items-center gap-1">
                                                        <Clock className="w-3 h-3 text-blue-400" />
                                                        {fmtTime(record.data_inicio)}
                                                    </div>
                                                </td>
                                                <td className="px-4 py-2.5 font-mono text-xs text-slate-700">
                                                    {fmtTime(record.data_fim)}
                                                </td>
                                                <td className="px-4 py-2.5 text-xs font-semibold text-indigo-600">
                                                    {calcDuration(record.data_inicio, record.data_fim)}
                                                </td>
                                                <td className="px-4 py-2.5">
                                                    <span className="bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold text-xs">
                                                        {Number(record.quantidade || 0).toFixed(0)} pc
                                                    </span>
                                                </td>
                                                <td className="px-4 py-2.5">
                                                    <div className="flex items-center gap-2">
                                                        <div className="w-6 h-6 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-[10px] font-bold">
                                                            {(record.usuario || 'U').charAt(0).toUpperCase()}
                                                        </div>
                                                        <span className="text-xs font-medium text-slate-700">{record.usuario || 'Sistema'}</span>
                                                    </div>
                                                </td>
                                                <td className="px-4 py-2.5 text-xs">
                                                    {record.conferencia_status === 'OK' ? (
                                                        <div className="flex flex-col gap-0.5">
                                                            <span className="text-green-600 font-bold flex items-center gap-1">
                                                                <CheckCircle className="w-3.5 h-3.5" /> Aprovado
                                                            </span>
                                                            {record.conferido_por && <span className="text-slate-400 text-[10px]">por {record.conferido_por}</span>}
                                                        </div>
                                                    ) : record.conferencia_status === 'DIVERGENTE' ? (
                                                        <div className="flex flex-col gap-0.5">
                                                            <span className="text-red-600 font-bold flex items-center gap-1">
                                                                <XCircle className="w-3.5 h-3.5" /> Recusado
                                                            </span>
                                                            {record.conferido_por && <span className="text-slate-400 text-[10px]">por {record.conferido_por}</span>}
                                                            {record.conferencia_obs && <span className="text-red-500 italic text-[10px] max-w-[150px] truncate" title={record.conferencia_obs}>{record.conferencia_obs}</span>}
                                                        </div>
                                                    ) : (
                                                        <div className="flex flex-col gap-1">
                                                            <span className="text-orange-500 font-bold flex items-center gap-1">
                                                                <AlertTriangle className="w-3.5 h-3.5" /> Pendente
                                                            </span>
                                                            {canConferir && (
                                                                <div className="flex gap-1.5 mt-1">
                                                                    <button
                                                                        disabled={isSaving}
                                                                        onClick={() => handleConferencia(record.id, 'OK')}
                                                                        className="text-[10px] px-2 py-1 bg-green-100 hover:bg-green-200 text-green-700 rounded font-medium transition disabled:opacity-50"
                                                                    >
                                                                        {isSaving ? '...' : '✓ Aprovar'}
                                                                    </button>
                                                                    <button
                                                                        disabled={isSaving}
                                                                        onClick={() => handleRecusar(record.id)}
                                                                        className="text-[10px] px-2 py-1 bg-red-100 hover:bg-red-200 text-red-700 rounded font-medium transition disabled:opacity-50"
                                                                    >
                                                                        ✕ Recusar
                                                                    </button>
                                                                </div>
                                                            )}
                                                        </div>
                                                    )}
                                                    {record.observacao && (
                                                        <div className="mt-1 max-w-[150px] truncate text-[10px] italic text-slate-400" title={record.observacao}>
                                                            Obs: {record.observacao}
                                                        </div>
                                                    )}
                                                </td>
                                            </tr>
                                        );
                                    })}
                                </tbody>
                                <tfoot className="bg-slate-50 font-bold text-xs text-slate-700 border-t-2 border-slate-200">
                                    <tr>
                                        <td colSpan="4" className="px-4 py-3 text-right">Totais:</td>
                                        <td className="px-4 py-3 text-indigo-600">
                                            {totalH > 0 ? `${totalH}h${String(totalM).padStart(2, '0')}min` : `${totalM}min`}
                                        </td>
                                        <td className="px-4 py-3">
                                            <span className="bg-blue-100 text-blue-700 px-2 py-0.5 rounded">
                                                {totalQty.toFixed(0)} pc
                                            </span>
                                        </td>
                                        <td colSpan="2" className="px-4 py-3 text-slate-400">
                                            {history.length} apontamento{history.length !== 1 ? 's' : ''}
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        )}
                    </div>

                    {/* Footer */}
                    <div className="p-3 border-t bg-slate-50 rounded-b-xl flex justify-end">
                        <button onClick={onClose} className="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-medium text-sm transition-colors">
                            Fechar
                        </button>
                    </div>
                </div>
            </div>

            {/* Modal de Motivo da Recusa */}
            {recusaModal && (
                <div className="fixed inset-0 z-[70] flex items-center justify-center bg-black/60 p-4">
                    <div className="bg-white rounded-xl shadow-2xl w-full max-w-lg p-6">
                        <div className="flex items-center gap-3 mb-4">
                            <div className="w-10 h-10 rounded-full bg-red-100 flex items-center justify-center">
                                <XCircle className="w-5 h-5 text-red-600" />
                            </div>
                            <div>
                                <h3 className="font-bold text-slate-800">Recusar Apontamento</h3>
                                <p className="text-sm text-slate-500">Informe o motivo e, se necessário, anexe fotos como evidência</p>
                            </div>
                        </div>
                        <textarea
                            className="w-full border rounded-lg p-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-red-300"
                            rows={3}
                            placeholder="Ex: Quantidade incorreta, operação não executada, etc."
                            value={motivoRecusa}
                            onChange={e => setMotivoRecusa(e.target.value)}
                            autoFocus
                        />
                        {/* Upload de fotos */}
                        <div className="mt-3">
                            <p className="text-xs font-medium text-slate-600 mb-2">Fotos de evidência (opcional — máx. 5)</p>
                            <div className="flex flex-wrap gap-2">
                                {fotosPreview.map((src, idx) => (
                                    <div key={idx} className="relative w-16 h-16 rounded-lg overflow-hidden border border-slate-200 group">
                                        <img src={src} alt={`foto ${idx + 1}`} className="w-full h-full object-cover" />
                                        <button
                                            onClick={() => removerFoto(idx)}
                                            className="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition"
                                        >
                                            <Trash2 className="w-4 h-4 text-white" />
                                        </button>
                                    </div>
                                ))}
                                {fotosRecusa.length < 5 && (
                                    <button
                                        onClick={() => fotoInputRef.current?.click()}
                                        className="w-16 h-16 rounded-lg border-2 border-dashed border-slate-300 hover:border-blue-400 flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-blue-500 transition"
                                        title="Adicionar foto"
                                    >
                                        <Camera className="w-5 h-5" />
                                        <span className="text-[9px] font-medium">Foto</span>
                                    </button>
                                )}
                            </div>
                            <input
                                ref={fotoInputRef}
                                type="file"
                                accept="image/*"
                                multiple
                                className="hidden"
                                onChange={handleFotosChange}
                            />
                            <p className="text-[10px] text-slate-400 mt-1 flex items-center gap-1">
                                <ImagePlus className="w-3 h-3" />
                                No celular: abre câmera ou galeria. No PC: selecione arquivos de imagem.
                            </p>
                        </div>
                        <div className="flex justify-end gap-2 mt-4">
                            <button
                                onClick={() => setRecusaModal(null)}
                                className="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-sm font-medium transition"
                            >
                                Cancelar
                            </button>
                            <button
                                onClick={confirmRecusa}
                                disabled={!motivoRecusa.trim()}
                                className="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition disabled:opacity-50"
                            >
                                Confirmar Recusa
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {/* Toast */}
            {toast && (
                <div className={`fixed bottom-6 right-6 z-[80] px-4 py-3 rounded-lg shadow-lg text-white text-sm font-medium flex items-center gap-2 transition-all ${toast.type === 'success' ? 'bg-green-600' : 'bg-red-600'}`}>
                    {toast.type === 'success' ? <CheckCircle className="w-4 h-4" /> : <XCircle className="w-4 h-4" />}
                    {toast.msg}
                </div>
            )}
        </>
    );
}

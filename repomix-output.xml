            return res.status(500).json({ error: 'Erro de permissão no Linux (EACCES). O diretório de rede pai não está montado ou mapeado na nuvem Sinco.' });
        }
        res.status(500).json({ error: 'Erro ao gravar no servidor: ' + err.message });
    }
});


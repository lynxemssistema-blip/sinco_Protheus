                                                    <span className="text-slate-500 text-[10px]">{new Date(log.created_at).toLocaleString('pt-BR')}</span>
                                                </div>
                                                <div className="text-slate-300 text-xs">
                                                    {TranslateAcao(log.acao, dt)}
                                                </div>
                                            </div>
                                        </div>

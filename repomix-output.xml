                    </td>
                    {meses.map(m => (
                        <td key={m} className="px-4 py-2.5 text-center font-mono text-xs font-bold text-slate-700 border-r border-slate-200">
                            {(g.totalMeses[m] || 0) > 0 ? fmtNum(g.totalMeses[m]) : <span className="text-slate-300">-</span>}
                        </td>

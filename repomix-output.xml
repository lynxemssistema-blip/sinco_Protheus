    const [showHistory, setShowHistory] = useState(true);

    useEffect(() => {
        if (!open || !opData?.id) return;
        const n = new Date();
        const h = new Date(n.getTime() - 60 * 60 * 1000);
        setFormData({
            quantidade: '',
            observacao: '',
            data_inicio: h.toISOString().split('T')[0],

<file path="client/src/pages/sgq/MapeamentoProcessos.jsx">
import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { toast } from 'react-toastify';
import { Layers, GitCommit, Search, RefreshCw, Loader2 } from 'lucide-react';
import SgqFlowTab from './SgqFlowTab';
import SgqOrganogramTab from './SgqOrganogramTab';
import SgqProcessModal from './SgqProcessModal';

export default function MapeamentoProcessos() {
    const [processos, setProcessos] = useState([]);
    const [loading, setLoading] = useState(true);
    const [activeTab, setActiveTab] = useState('flow'); 
    
    // Modal State
    const [selectedProcess, setSelectedProcess] = useState(null);

    const loadData = async () => {
        setLoading(true);
        try {
            const token = localStorage.getItem('@MetalFisa:token');
            const res = await axios.get('/api/sgq/processos', {
                headers: { Authorization: `Bearer ${token}` }
            });
            setProcessos(res.data);
        } catch (err) {
            console.error(err);
            toast.error('Erro ao carregar Mapeamento SGQ');
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        loadData();
    }, []);

    const handleNodeClick = (processOrId) => {
        // processOrId can be the full object or just the ID.
        if (typeof processOrId === 'object') {
            setSelectedProcess(processOrId);
        } else {
            const proc = processos.find(p => p.id === processOrId);
            if (proc) setSelectedProcess(proc);
        }
    };

    const handleSaveProcess = async (updatedData) => {
        try {
             const token = localStorage.getItem('@MetalFisa:token');
             await axios.put(`/api/sgq/processos/${selectedProcess.id}`, updatedData, {
                 headers: { Authorization: `Bearer ${token}` }
             });
             toast.success('Processo atualizado com sucesso!');
             setSelectedProcess(null);
             loadData(); // refresh tree
        } catch(e) {
             toast.error('Erro ao salvar processo.');
        }
    };

    return (
        <div className="flex flex-col h-[calc(100vh-6rem)] bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            {/* Header */}
            <div className="flex flex-shrink-0 items-center justify-between p-4 border-b border-slate-200 bg-slate-50">
                <div>
                     <h2 className="text-xl font-bold tracking-tight text-slate-800 flex items-center gap-2">
                          <Layers className="h-6 w-6 text-blue-600" />
                          Mapeamento de Processos (SGQ)
                     </h2>
                     <p className="text-sm text-slate-500 mt-1">
                          Organograma dinâmico de todos os Módulos do Sistema ERP/PCP.
                     </p>
                </div>
                <div className="flex items-center gap-3">
                     <button
                         onClick={loadData}
                         className="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors"
                         title="Recarregar Árvore"
                     >
                         <RefreshCw className={`h-5 w-5 ${loading ? 'animate-spin' : ''}`} />
                     </button>
                </div>
            </div>

            {/* Tabs */}
            <div className="border-b border-slate-200 flex gap-1 bg-white px-2">
                 <button
                     onClick={() => setActiveTab('flow')}
                     className={`flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 transition-colors ${activeTab === 'flow' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'}`}
                 >
                     <GitCommit className="h-4 w-4" />
                     Aba A: Mapa Mental Interativo (ReactFlow)
                 </button>
                 <button
                     onClick={() => setActiveTab('css')}
                     className={`flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 transition-colors ${activeTab === 'css' ? 'border-blue-600 text-blue-600' : 'border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300'}`}
                 >
                     <Layers className="h-4 w-4" />
                     Aba B: Organograma Nativo
                 </button>
            </div>

            {/* Content Area */}
            <div className="flex-1 relative bg-slate-50 overflow-hidden">
                {loading && processos.length === 0 ? (
                    <div className="absolute inset-0 flex items-center justify-center bg-white/80 z-10">
                        <Loader2 className="h-8 w-8 animate-spin text-blue-600" />
                    </div>
                ) : null}

                {!loading && activeTab === 'flow' && <SgqFlowTab data={processos} onNodeClick={handleNodeClick} />}
                {!loading && activeTab === 'css' && <SgqOrganogramTab data={processos} onNodeClick={handleNodeClick} />}
            </div>

            {/* Edicao SGQ Modal */}
            {selectedProcess && (
                <SgqProcessModal 
                    process={selectedProcess} 
                    onClose={() => setSelectedProcess(null)} 
                    onSave={handleSaveProcess} 
                />
            )}
        </div>
    );
}
</file>

<file path="client/src/pages/sgq/SgqFlowTab.jsx">
import React, { useMemo } from 'react';
import { ReactFlow, MiniMap, Controls, Background, MarkerType } from '@xyflow/react';
import '@xyflow/react/dist/style.css';

// Usado para auto-layoutar em formato de arvore
import * as d3 from 'd3-hierarchy';

const SgqFlowTab = ({ data, onNodeClick }) => {

    const { nodes, edges } = useMemo(() => {
        if (!data || data.length === 0) return { nodes: [], edges: [] };

        // 1. Agrupar por Categorias
        // A raiz é 'MetalFisa'
        const hierarchyData = {
            id: 'root',
            name: 'MetalFisa Sistema',
            type: 'root',
            children: []
        };

        const categoriesMap = {};
        
        data.forEach(proc => {
            const catName = proc.category || 'Outros';
            if (!categoriesMap[catName]) {
                categoriesMap[catName] = { 
                    id: `cat_${catName}`, 
                    name: catName, 
                    type: 'category', 
                    color: proc.category_color || '#64748b',
                    children: [] 
                };
            }
            categoriesMap[catName].children.push({
                ...proc,
                type: 'process',
                name: proc.title || proc.route_path
            });
        });

        hierarchyData.children = Object.values(categoriesMap);

        // 2. Usar d3-hierarchy pra achar coordenadas automáticas
        const root = d3.hierarchy(hierarchyData);
        // Arvore espaçada. d3.tree mapeia [0..1] x [0..1] por padrão, entao setamos o tamanho do grid.
        // dx e dy sao o passo do nó.
        // Reordenando para layout Horizontal (Esquerda-Direita)
        const treeLayout = d3.tree().nodeSize([100, 350]);
        treeLayout(root);

        const flowNodes = [];
        const flowEdges = [];

        root.each(d => {
            const isRoot = d.data.id === 'root';
            const isCategory = d.data.type === 'category';

            flowNodes.push({
                id: d.data.id ? String(d.data.id) : String(d.data.title),
                type: 'default',
                targetPosition: 'left',
                sourcePosition: 'right',
                position: { x: d.y, y: d.x }, // Layout Horizontal
                data: {
                    label: (
                        <div className="flex flex-col items-center justify-center p-2 text-center" 
                             onClick={() => { if(d.data.type === 'process') onNodeClick(d.data.id) }}>
                            <div className="font-bold text-sm mb-1">{d.data.name}</div>
                            {d.data.type === 'process' && d.data.responsables && d.data.responsables.length > 0 && (
                                <div className="text-[10px] text-emerald-700 bg-emerald-100 rounded px-1 max-w-[150px] truncate">
                                    {d.data.responsables.join(', ')}
                                </div>
                            )}
                            {d.data.type === 'process' && (!d.data.responsables || d.data.responsables.length === 0) && (
                                <div className="text-[10px] text-slate-400 bg-slate-100 rounded px-1">Sem responsável</div>
                            )}
                        </div>
                    )
                },
                style: {
                    width: 180,
                    backgroundColor: isRoot ? '#0f172a' : isCategory ? (d.data.color || '#3b82f6') : '#ffffff',
                    color: isCategory || isRoot ? '#ffffff' : '#0f172a',
                    border: isCategory || isRoot ? 'none' : '2px solid #e2e8f0',
                    borderRadius: isRoot ? '12px' : '8px',
                    boxShadow: '0 4px 6px -1px rgb(0 0 0 / 0.1)',
                    cursor: d.data.type === 'process' ? 'pointer' : 'default',
                    transition: 'all 0.2s'
                }
            });

            if (d.parent) {
                flowEdges.push({
                    id: `e_${d.parent.data.name}_to_${d.data.name}`,
                    source: d.parent.data.id ? String(d.parent.data.id) : String(d.parent.data.title),
                    target: d.data.id ? String(d.data.id) : String(d.data.title),
                    type: 'smoothstep',
                    animated: d.data.type === 'process',
                    markerEnd: {
                        type: MarkerType.ArrowClosed,
                        color: '#94a3b8',
                    },
                    style: { stroke: '#cbd5e1', strokeWidth: 2 }
                });
            }
        });

        // Corrigindo IDs
        flowNodes.forEach(n => {
            if(n.id.includes('undefined')) n.id = Math.random().toString();
        });

        return { nodes: flowNodes, edges: flowEdges };
    }, [data, onNodeClick]);

    return (
        <div className="w-full h-full absolute inset-0">
            <ReactFlow
                nodes={nodes}
                edges={edges}
                fitView
                fitViewOptions={{ padding: 0.2 }}
                minZoom={0.1}
                nodesConnectable={false}
                nodesDraggable={true}
                elementsSelectable={true}
            >
                <Controls />
                <MiniMap />
                <Background variant="dots" gap={12} size={1} color="#cbd5e1" />
            </ReactFlow>
        </div>
    );
}

export default SgqFlowTab;
</file>

<file path="client/src/pages/sgq/SgqOrganogramTab.jsx">
import React, { useMemo } from 'react';
import { Layers, Users, ChevronRight, FileText } from 'lucide-react';

export default function SgqOrganogramTab({ data, onNodeClick }) {
    
    const tree = useMemo(() => {
        if (!data || data.length === 0) return {};
        const categories = {};
        data.forEach(proc => {
            const cat = proc.category || 'Outros';
            if(!categories[cat]) categories[cat] = [];
            categories[cat].push(proc);
        });
        return categories;
    }, [data]);

    return (
        <div className="p-8 overflow-y-auto h-full bg-slate-50 print:bg-white print:p-0 absolute inset-0">

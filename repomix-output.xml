}

// ─── Main Component ────────────────────────────────────────────────────────────
const EngineeringOrdersPage = () => {
    const location = useLocation();
    const { user } = useAuth();
    const { orderFilters, updateOrderFilters } = useFilters();
    
    const canViewFinancials = user?.permissoes?.some(p => p.page_id === 'valores_financeiros' && p.can_view);

    const viewMode = 'flat';
    const [orders, setOrders] = useState([]);
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState(null);
    const [totalPages, setTotalPages] = useState(1);
    const limit = 50;

    // Tipo frontend filter (multi-select)
    const [tipoFilter, setTipoFilter] = useStickyState([], '@metalfisa:eng_tipoFilter');
    // Emissão frontend filter (single date)
    const [emissaoFilter, setEmissaoFilter] = useStickyState('', '@metalfisa:eng_emissaoFilter');
    const [showSettings, setShowSettings] = useState(false);
    const [colConfig, setColConfig] = useState(() => loadColConfigLocal());
    
    // Engineering Timesheet Active Timer
    const [activeTimer, setActiveTimer] = useState(null);

    const fetchActiveTimer = async () => {
        try {
            const res = await api.get('/engineering-timesheets/active');
            setActiveTimer(res.data.activeTimer);
        } catch (err) {
            console.error('Error fetching active timer', err);
        }
    };

    const toggleTimer = async (pedido, itemCode) => {
        try {
            // Is this item already playing?
            if (activeTimer && activeTimer.pedido === pedido && activeTimer.item === itemCode) {
                // Stop it
                await api.post('/engineering-timesheets/stop', { id: activeTimer.id });
                setActiveTimer(null);
            } else {
                // It will auto-stop the previous one backend-side
                const res = await api.post('/engineering-timesheets/start', { pedido, item: itemCode });
                fetchActiveTimer();
            }
        } catch (err) {
            alert('Falha ao iniciar/parar apontamento de engenharia.');
            console.error(err);
        }
    };

    // Load column config from server (per-user) on mount
    useEffect(() => {
        loadColConfigFromServer().then(serverCols => {
            if (serverCols) {
                setColConfig(serverCols);
                localStorage.setItem(PREF_KEY, JSON.stringify(serverCols));
            }
        });
    }, []);

    // Modal states
    const [isDocsModalOpen, setIsDocsModalOpen] = useState(false);
    const [selectedProductForDocs, setSelectedProductForDocs] = useState({ code: '', name: '' });
    const [showImageModal, setShowImageModal] = useState(false);
    const [selectedProductForImage, setSelectedProductForImage] = useState(null);
    const [notesTarget, setNotesTarget] = useState(null);
    const [engineeringTarget, setEngineeringTarget] = useState(null);
    const [showReportModal, setShowReportModal] = useState(false);
    const [isGlobalReport, setIsGlobalReport] = useState(false);
    const [pcpForecastTarget, setPcpForecastTarget] = useState(null);
    const [downloadingPDF, setDownloadingPDF] = useState(false);
    const [pcpmetalOpen, setPcpmetalOpen] = useState(false);
    const [pcpmetalContext, setPcpmetalContext] = useState({});
    const [selectedInvoice, setSelectedInvoice] = useState(null);
    const [invoiceModalItem, setInvoiceModalItem] = useState(null);
    // PCP Planned date modal
    const [planModalTarget, setPlanModalTarget] = useState(null); // { pedido, item, currentDate, currentObs }

    const filters = {
        cliente: orderFilters.cliente,
        pedido: orderFilters.pedido,
        produto: orderFilters.produto,
        dataInicial: orderFilters.dataInicial,
        dataFinal: orderFilters.dataFinal,
        dateType: orderFilters.dateType,
        only_active: orderFilters.only_active,
    };

    const setFilters = (val) => {
        if (typeof val === 'function') updateOrderFilters(val(orderFilters));
        else updateOrderFilters(val);
    };

    const page = orderFilters.page;
    const setPage = (val) => {
        const newPage = typeof val === 'function' ? val(page) : val;
        updateOrderFilters({ page: newPage });
    };

    // Filtered view: chained frontend filters (tipo + emissão)
    const filteredOrders = orders.filter(item => {
        if (tipoFilter.length > 0) {
            const tipo = item.status_tipo_item || 'PCP';
            if (!tipoFilter.includes(tipo)) return false;
        }
        if (emissaoFilter) {
            const formatted = formatProtheusDate(item.emissao);
            const [y, m, d] = emissaoFilter.split('-');
            if (formatted !== `${d}/${m}/${y}`) return false;
        }
        return true;
    });


    const fetchData = async (overrides = {}) => {
        setLoading(true);
        setError(null);
        try {
            const searchFilters = { ...filters, ...overrides };
            const searchPage = overrides.page || page;
            const result = await getPedidosFlat({ ...searchFilters, page: searchPage, limit });
            const { data, meta } = result;
            setOrders(data);
            setTotalPages(Math.ceil(meta.total / limit));
        } catch (err) {
            const serverError = err.response?.data;
            const errorMsg = serverError
                ? typeof serverError === 'object' ? JSON.stringify(serverError, null, 2) : serverError
                : err.message;
            setError(`Erro ao carregar dados: ${errorMsg}`);
        } finally {
            setLoading(false);
        }
    };

    useEffect(() => {
        fetchData();
        fetchActiveTimer();
        // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [page, viewMode, filters.only_active]);

    const handleFilterChange = (e) => {
        const { name, value } = e.target;
        setFilters(prev => ({ ...prev, [name]: value }));
    };

    const handleSearch = (e) => {
        e.preventDefault();
        setPage(1);
        fetchData({ page: 1 });
    };

    const handleOpenDocs = (code, name) => {
        setSelectedProductForDocs({ code, name });
        setIsDocsModalOpen(true);
    };

    const handleSaveEngineeringControl = (pedido, itemCode, newData) => {
        setOrders(prev => prev.map(i =>
            (i.pedido === pedido && i.item === itemCode) ? { ...i, ...newData } : i
        ));
    };

    // Exportar Espelho OS Corte Laser (MO0013) — requer filtro por pedido específico
    const handleDownloadLaserExport = () => {
        const pedido = (filters.pedido || '').trim();
        if (!pedido) {
            alert('Filtre por um número de pedido específico para gerar o Espelho OS Corte (Laser).');
            return;
        }
        const token = localStorage.getItem('@MetalFisa:token') || '';
        window.open(`/api/pedidos/op-mirror/${encodeURIComponent(pedido)}/export-laser?token=${token}`, '_blank');
    };

    // Excel — export ALL data matching current filters (no pagination limit)
    const handleDownloadExcel = () => {
        const reportFilters = {
            client: filters.cliente,
            order: filters.pedido,
            product: filters.produto,
            emission_start: filters.dataInicial,
            emission_end: filters.dataFinal,
            active_only: filters.only_active,
            // Request all pages
            limit: 99999,
            page: 1
        };
        const url = getReportDownloadUrl('xlsx', reportFilters, 'sales-planning');
        window.open(url, '_blank');
    };


    // Render cell content for a given column key and row
    const renderCell = (colKey, item) => {
        switch (colKey) {
            case 'pedido':
                return <span className="font-bold text-gray-900">{item.pedido}</span>;
            case 'emissao':
                return (
                    <div className="flex items-center justify-center gap-1 text-xs text-gray-600">
                        <Calendar className="h-3 w-3 text-gray-400" />
                        {formatProtheusDate(item.emissao)}
                    </div>
                );
            case 'cliente':
                return <div className="text-xs font-medium text-gray-700 truncate max-w-[160px]" title={item.nome_cliente}>{item.nome_cliente}</div>;
            case 'pc':
                return <span className="text-xs text-gray-600">{item.ped_cliente || '-'}</span>;
            case 'item':
                return <span className="text-xs font-mono text-gray-500">{item.item}</span>;
            case 'op':
                return <span className="text-xs font-mono bg-blue-50 text-blue-700 px-1.5 py-0.5 rounded">{item.op_num || '-'}</span>;
            case 'codigo':
                return (
                    <Link
                        to={`/estrutura/${encodeURIComponent(item.codigo)}`}
                        state={{ from: location.pathname }}
                        className="text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1 text-xs font-mono"
                    >
                        {item.codigo} <Layers className="h-3 w-3" />
                    </Link>
                );
            case 'c6_xrevm':
                return <span className="text-xs text-gray-500 font-mono">{item.rev_codigo || '-'}</span>;
            case 'tipo':
                return <TipoBadge tipo={item.status_tipo_item} detalhe={item.status_tipo_detalhe} />;
            case 'ref_cliente':
                return <span className="text-xs font-mono text-gray-600">{item.ref_cliente || '-'}</span>;
            case 'rev_cliente':
                return <span className="text-xs font-semibold text-gray-700">{item.c6_rev_cliente || '-'}</span>;
            case 'acoes':
                return (
                    <div className="flex items-center justify-center gap-1">
                        <button
                            onClick={() => {
                                if (item.has_drawing && item.drawing_url) {
                                    window.open(getFileUrl(`/api/docs/view?path=${encodeURIComponent(item.drawing_url)}`), '_blank');
                                } else if (item.docs_count === 1 && item.first_doc) {
                                    window.open(getFileUrl(`/api/docs/view?path=${encodeURIComponent(item.first_doc)}`), '_blank');
                                } else {
                                    handleOpenDocs(item.codigo, item.descricao);
                                }
                            }}
                            className={`p-1.5 rounded-lg transition-all relative ${item.has_docs ? 'text-red-600 bg-red-50 hover:bg-red-100 ring-1 ring-red-200' : 'text-gray-400 hover:text-red-600 hover:bg-red-50'}`}
                            title={item.has_docs ? `${item.docs_count} Documento(s)` : 'Documentos'}
                        >
                            <FileText className="h-4 w-4" />
                            {item.has_docs && (
                                <span className="absolute -top-1 -right-1 flex h-3 w-3">
                                    <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                    <span className="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                                </span>
                            )}
                        </button>
                        <button
                            onClick={() => setEngineeringTarget({ orderId: item.pedido, item })}
                            className="p-1.5 text-gray-400 hover:text-indigo-600 transition-all bg-gray-50/50 hover:bg-indigo-50 rounded"
                            title="Controle de Engenharia"
                        >
                            <Settings className="h-4 w-4" />
                        </button>
                        {activeTimer && activeTimer.pedido === item.pedido && activeTimer.item === item.item ? (
                            <button
                                onClick={() => toggleTimer(item.pedido, item.item)}
                                className="p-1.5 text-orange-600 bg-orange-100 hover:bg-orange-200 transition-all rounded ring-1 ring-orange-300 animate-pulse"
                                title="Parar Apontamento (Salva as horas gastas)"
                            >
                                <Square className="h-4 w-4 fill-current" />
                            </button>
                        ) : (
                            <button
                                onClick={() => toggleTimer(item.pedido, item.item)}
                                className="p-1.5 text-gray-400 hover:text-green-600 transition-all bg-gray-50/50 hover:bg-green-50 rounded"
                                title="Iniciar Apontamento (Pausa outros automaticamente)"
                            >
                                <Play className="h-4 w-4" />
                            </button>
                        )}
                    </div>
                );
            case 'descricao':
                return <span className="text-xs text-gray-600 truncate max-w-[220px]" title={item.descricao}>{item.descricao}</span>;
            case 'status':
                return parseFloat(item.qtd_faturar) <= 0
                    ? <span className="px-2 py-0.5 text-[9px] font-bold bg-green-100 text-green-700 rounded border border-green-200">ENTREGUE</span>
                    : <span className="px-2 py-0.5 text-[9px] font-bold bg-orange-100 text-orange-700 rounded border border-orange-200">PENDENTE</span>;
            case 'qtd_entregue':
                return <span className="text-gray-600">{parseFloat(item.qtd_entreg || 0).toLocaleString('pt-BR')}</span>;
            case 'saldo':
                return (
                    <span className={`font-medium ${parseFloat(item.qtd_faturar) <= 0 ? 'text-green-600' : 'text-orange-600 font-bold'}`}>
                        {parseFloat(item.qtd_faturar || 0).toLocaleString('pt-BR')}
                    </span>
                );
            case 'valor_unitario':
                return <span className="font-mono text-gray-700 whitespace-nowrap">{formatCurrency(item.valor_unitario)}</span>;
            case 'valor_total':
                return <span className="font-mono font-bold text-gray-900 whitespace-nowrap">{formatCurrency(item.valor_total)}</span>;
            case 'quantidade':
                return (
                    <span className="font-medium">
                        {parseFloat(item.quantidade).toLocaleString('pt-BR')} <span className="text-[10px] text-gray-400">{item.unidade}</span>
                    </span>
                );
            case 'lib_producao': {
                const planned = item.pcp_planned_eng_date;
                const released = item.designer_production_release_date;
                return (
                    <div
                        className="flex flex-col gap-1 cursor-pointer group"
                        title="Clique para definir/editar data planejada"
                        onClick={() => setPlanModalTarget({
                            pedido: item.pedido,
                            item: item.item,
                            currentDate: planned,
                            currentObs: item.pcp_planned_eng_obs
                        })}
                    >
                        {/* Planejado line */}
                        <div className={`flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold border transition-all ${planned
                            ? 'bg-indigo-50 text-indigo-700 border-indigo-200 group-hover:bg-indigo-100'
                            : 'bg-gray-50 text-gray-400 border-dashed border-gray-200 group-hover:border-indigo-300'
                            }`}>
                            <Calendar className="h-2.5 w-2.5" />
                            <span>Plan: {planned ? new Date(planned).toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : 'Definir...'}</span>
                        </div>
                        {/* Realizado line */}
                        {released && (
                            <div className="flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-green-50 text-green-700 border border-green-200">
                                <Calendar className="h-2.5 w-2.5" />
                                <span>Real: {new Date(released).toLocaleDateString('pt-BR', { timeZone: 'UTC' })}</span>
                            </div>
                        )}
                    </div>
                );
            }
            case 'entrega':
                return (
                    <div className="flex items-center justify-center gap-1 font-medium text-blue-800 bg-blue-50 rounded px-1.5 py-0.5 text-xs">
                        <Calendar className="h-3 w-3 text-blue-400" />
                        {item.entrega ? item.entrega.replace(/(\d{4})(\d{2})(\d{2})/, '$3/$2/$1') : '-'}
                    </div>
                );
            case 'qtd_pcp':
                return (
                    <div
                        className="cursor-pointer hover:bg-teal-50 rounded px-1 py-0.5 transition-colors group/pcp"
                        onClick={() => setPcpForecastTarget(item)}
                        title="Clique para definir Qtd. PCP"
                    >
                        <span className="text-xs font-medium text-teal-700 group-hover/pcp:text-teal-900">
                            {item.pcp_delivery_forecast_qtd ? parseFloat(item.pcp_delivery_forecast_qtd).toLocaleString('pt-BR') : 'Definir...'}
                        </span>
                    </div>
                );
            case 'data_pcp':
                return (
                    <div
                        className="cursor-pointer hover:bg-teal-50 rounded px-1 py-0.5 transition-colors group/pcp"
                        onClick={() => setPcpForecastTarget(item)}
                        title="Clique para definir Data PCP"
                    >
                        {item.pcp_delivery_forecast_date ? (
                            <span className="px-1.5 py-0.5 rounded bg-teal-50 text-teal-700 border border-teal-200 text-[10px] font-semibold group-hover/pcp:border-teal-400">
                                {new Date(item.pcp_delivery_forecast_date).toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
                            </span>
                        ) : <span className="text-xs text-gray-400 group-hover/pcp:text-teal-600">Definir...</span>}
                    </div>
                );
            default:
                return null;
        }
    };

    const visibleCols = colConfig.filter(c => c.visible !== false && (canViewFinancials || !['valor_unitario', 'valor_total'].includes(c.key)));

    return (
        <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden print:overflow-visible print:shadow-none print:border-none">
            {/* Header & Filters */}
            <div className="p-4 border-b border-gray-100 bg-white print:hidden">
                <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-5">
                    <div>
                        <h2 className="text-xl font-bold text-gray-800 flex items-center gap-2">
                            <Layers className="h-6 w-6 text-indigo-600" />
                            Painel de Itens (Engenharia)
                        </h2>
                        <p className="text-sm text-gray-500">Visão plana de todos os componentes e produtos em desenvolvimento ou produção.</p>
                        {filters.only_active === 'true' && (
                            <div className="mt-2 text-xs text-blue-700 bg-blue-50 border border-blue-100 rounded-md px-2 py-1 inline-flex items-center gap-1.5">
                                <AlertCircle className="h-3 w-3" />
                                <span>Visualizando apenas itens <strong>Ativos</strong> (não entregues) e <strong>Vendas</strong> (exclui orçamentos).</span>
                            </div>
                        )}
                    </div>
                    <button
                        onClick={() => setShowSettings(true)}
                        className="flex items-center gap-2 px-3 py-2 rounded-xl border border-indigo-200 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition text-sm font-medium"
                        title="Configurar Colunas"
                    >
                        <Settings className="h-4 w-4" />
                        Colunas
                    </button>
                </div>

                <form onSubmit={handleSearch} className="grid grid-cols-1 md:grid-cols-8 gap-3 items-end">
                    {/* Cliente */}
                    <div className="flex flex-col gap-1">
                        <label className="text-[11px] font-medium text-gray-600 ml-1">Cliente:</label>
                        <div className="relative">
                            <Search className="absolute left-3 top-2.5 h-4 w-4 text-gray-400" />
                            <input
                                type="text"
                                name="cliente"
                                placeholder="Cliente..."
                                value={filters.cliente}
                                onChange={handleFilterChange}
                                className="pl-9 w-full rounded-lg border border-gray-200 bg-gray-50 p-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all"
                            />
                        </div>
                    </div>

                    {/* Pedido */}
                    <div className="flex flex-col gap-1">
                        <label className="text-[11px] font-medium text-gray-600 ml-1">Pedido:</label>
                        <div className="relative">
                            <Filter className="absolute left-3 top-2.5 h-4 w-4 text-gray-400" />
                            <input
                                type="text"
                                name="pedido"
                                placeholder="Nº Pedido..."
                                value={filters.pedido}
                                onChange={handleFilterChange}
                                className="pl-9 w-full rounded-lg border border-gray-200 bg-gray-50 p-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all"
                            />
                        </div>
                    </div>

                    {/* Produto */}
                    <div className="flex flex-col gap-1">
                        <label className="text-[11px] font-medium text-gray-600 ml-1">Produto:</label>
                        <div className="relative">
                            <Package className="absolute left-3 top-2.5 h-4 w-4 text-gray-400" />
                            <input
                                type="text"
                                name="produto"
                                placeholder="Cód. Produto..."
                                value={filters.produto}
                                onChange={handleFilterChange}
                                className="pl-9 w-full rounded-lg border border-gray-200 bg-gray-50 p-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all"
                            />
                        </div>
                    </div>

                    {/* Data Início */}
                    <div className="flex flex-col gap-1">
                        <div className="flex justify-between items-center mb-0.5">
                            <label className="text-[11px] font-medium text-gray-600">Início:</label>
                            <select
                                name="dateType"
                                value={filters.dateType}
                                onChange={handleFilterChange}
                                className="bg-transparent text-[11px] font-bold text-indigo-600 outline-none cursor-pointer p-0"
                            >
                                <option value="pedido">Emissão Pedido</option>
                                <option value="nf">Emissão NF</option>
                            </select>
                        </div>
                        <div className="relative">
                            <Calendar className="absolute left-3 top-2.5 h-4 w-4 text-gray-400" />
                            <input
                                type="date"
                                name="dataInicial"
                                value={filters.dataInicial}
                                onChange={handleFilterChange}
                                className="pl-9 w-full rounded-lg border border-gray-200 bg-gray-50 p-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all font-medium"
                            />
                        </div>
                    </div>

                    {/* Data Fim */}
                    <div className="flex flex-col gap-1">
                        <div className="flex justify-between items-center mb-0.5">
                            <label className="text-[11px] font-medium text-gray-600">Fim:</label>
                            <span className="text-[11px] font-bold text-indigo-600">{filters.dateType === 'pedido' ? 'Emissão Pedido' : 'Emissão NF'}</span>
                        </div>
                        <div className="relative">
                            <Calendar className="absolute left-3 top-2.5 h-4 w-4 text-gray-400" />
                            <input
                                type="date"
                                name="dataFinal"
                                value={filters.dataFinal}
                                onChange={handleFilterChange}
                                className="pl-9 w-full rounded-lg border border-gray-200 bg-gray-50 p-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all font-medium"
                            />
                        </div>
                    </div>

                    {/* Emissão — frontend date filter */}
                    <div className="flex flex-col gap-1">
                        <div className="flex justify-between items-center mb-0.5">
                            <label className="text-[11px] font-medium text-gray-600">Emissão:</label>
                            {emissaoFilter && (
                                <button type="button" onClick={() => setEmissaoFilter('')} className="text-[10px] text-indigo-500 hover:underline">✕ Limpar</button>
                            )}
                        </div>
                        <div className="relative">
                            <Calendar className="absolute left-3 top-2.5 h-4 w-4 text-gray-400" />
                            <input
                                type="date"
                                value={emissaoFilter}
                                onChange={(e) => setEmissaoFilter(e.target.value)}
                                className="pl-9 w-full rounded-lg border border-gray-200 bg-gray-50 p-2.5 text-sm outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition-all font-medium"
                                title="Filtrar pela coluna Emissão"
                            />
                        </div>
                    </div>

                    {/* Tipo — multi-select pills */}
                    <div className="flex flex-col gap-1 md:col-span-2">
                        <label className="text-[11px] font-medium text-gray-600 ml-1">Tipo de Item:</label>
                        <div className="flex flex-wrap gap-1.5">
                            {['PCP', 'Revisão', 'Restrição', 'Novo'].map(tipo => {
                                const active = tipoFilter.includes(tipo);
                                const colors = {
                                    PCP: active ? 'bg-gray-700 text-white border-gray-700' : 'bg-white text-gray-600 border-gray-300 hover:border-gray-500',
                                    Revisão: active ? 'bg-orange-500 text-white border-orange-500' : 'bg-white text-orange-600 border-orange-300 hover:border-orange-400',
                                    Restrição: active ? 'bg-red-500 text-white border-red-500' : 'bg-white text-red-600 border-red-300 hover:border-red-400',
                                    Novo: active ? 'bg-blue-500 text-white border-blue-500' : 'bg-white text-blue-600 border-blue-300 hover:border-blue-400',
                                };
                                return (
                                    <button
                                        key={tipo}
                                        type="button"
                                        onClick={() => setTipoFilter(prev =>
                                            prev.includes(tipo) ? prev.filter(t => t !== tipo) : [...prev, tipo]
                                        )}
                                        className={`px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all select-none ${colors[tipo]}`}
                                    >
                                        {tipo}
                                    </button>
                                );
                            })}
                            {tipoFilter.length > 0 && (
                                <button
                                    type="button"
                                    onClick={() => setTipoFilter([])}
                                    className="px-2 py-1.5 rounded-lg text-xs font-medium border border-gray-200 bg-gray-50 text-gray-500 hover:bg-gray-100 transition-all"
                                    title="Limpar filtro de tipo"
                                >
                                    ✕ Limpar
                                </button>
                            )}
                        </div>
                    </div>

                    {/* Action buttons */}
                    <div className="md:col-span-2 flex gap-2">
                        <button
                            type="submit"
                            className="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg text-sm px-5 py-2.5 text-center transition-colors flex items-center justify-center gap-2"
                        >
                            <Search className="h-4 w-4" />
                            Filtrar
                        </button>
                        <button
                            type="button"
                            onClick={handleDownloadExcel}
                            className="bg-green-50 hover:bg-green-100 text-green-700 border border-green-200 font-medium rounded-lg text-sm px-3 py-2.5 transition-colors flex items-center justify-center"
                            title="Exportar Excel (todos os filtros)"
                        >
                            <FileSpreadsheet className="h-4 w-4" />
                        </button>
                        <button
                            type="button"
                            onClick={handleDownloadLaserExport}
                            className="bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200 font-medium rounded-lg text-sm px-3 py-2.5 transition-colors flex items-center justify-center"
                            title="Exportar OS Corte Laser (MO0013) — filtre por pedido específico"
                        >
                            <Scissors className="h-4 w-4" />
                        </button>
                    </div>

                    {/* Toggle pendentes */}
                    <div className="md:col-span-6 flex flex-col gap-1 mt-1 bg-gray-50 p-2 rounded-lg border border-gray-100">
                        <div className="flex items-center gap-2">
                            <label className="relative inline-flex items-center cursor-pointer">
                                <input
                                    type="checkbox"
                                    checked={filters.only_active === 'true'}
                                    onChange={(e) => setFilters(prev => ({ ...prev, only_active: e.target.checked ? 'true' : 'false' }))}
                                    className="sr-only peer"
                                />
                                <div className="w-9 h-5 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-indigo-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600"></div>
                                <span className="ml-3 text-sm font-medium text-gray-700">Apenas Pendentes (Filtro Pesado)</span>
                            </label>
                            <span className="text-[10px] text-gray-400 italic flex items-center gap-1">
                                <AlertCircle className="h-3 w-3" />
                                Desative para uma busca muito mais rápida.
                            </span>
                        </div>
                        <div className="text-[10px] text-gray-400 italic">
                            Datas do filtro = <span className="font-semibold text-gray-500">Entrada/Emissão do pedido</span> (Protheus).
                            {tipoFilter.length > 0 && <span className="ml-2 text-indigo-500 font-semibold">Tipo ativo: {tipoFilter.join(', ')} ({filteredOrders.length} itens)</span>}
                        </div>
                    </div>
                </form>
            </div>

            {/* Table */}
            <div className="overflow-x-scroll min-h-[400px] print:overflow-visible print:min-h-0">
                <table className="w-full text-sm text-left text-gray-500 print:w-full">
                    <thead className="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
                        <tr>
                            {visibleCols.map(col => (
                                <th
                                    key={col.key}
                                    className={`px-4 py-3 font-semibold whitespace-nowrap ${col.key === 'acoes' ? 'print:hidden text-center' : ''} ${['qtd_entregue', 'saldo', 'quantidade', 'qtd_pcp', 'valor_unitario', 'valor_total'].includes(col.key) ? 'text-right' : ''} ${['emissao', 'op', 'c6_xrevm', 'tipo', 'item', 'status', 'lib_producao', 'entrega', 'data_pcp'].includes(col.key) ? 'text-center' : ''}`}
                                >
                                    {col.label}
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-50">
                        {loading ? (
                            <tr>
                                <td colSpan={visibleCols.length} className="px-6 py-12 text-center">
                                    <div className="flex flex-col items-center justify-center gap-2">
                                        <div className="h-8 w-8 animate-spin rounded-full border-4 border-indigo-600 border-t-transparent"></div>
                                        <span className="text-gray-400 font-medium">Carregando dados...</span>
                                    </div>
                                </td>
                            </tr>
                        ) : error ? (
                            <tr>
                                <td colSpan={visibleCols.length} className="px-6 py-12 text-center text-red-500">
                                    <div className="flex flex-col items-center gap-2">
                                        <AlertCircle className="h-8 w-8" />
                                        <span className="font-semibold">{error}</span>
                                    </div>
                                </td>
                            </tr>
                        ) : filteredOrders.length === 0 ? (
                            <tr>
                                <td colSpan={visibleCols.length} className="px-6 py-12 text-center text-gray-400">
                                    Nenhum registro encontrado com estes filtros.
                                </td>
                            </tr>
                        ) : (
                            filteredOrders.map((item, idx) => (
                                <tr
                                    key={`${item.pedido}-${item.item}-${idx}`}
                                    className={`transition-colors border-b border-gray-50 last:border-0 ${parseFloat(item.qtd_faturar) <= 0 ? 'bg-green-50/40 hover:bg-green-100/50 opacity-80' : 'bg-white hover:bg-slate-50'}`}
                                >
                                    {visibleCols.map(col => (
                                        <td
                                            key={col.key}
                                            className={`px-4 py-2 ${col.key === 'acoes' ? 'text-center print:hidden' : ''} ${['qtd_entregue', 'saldo', 'quantidade', 'qtd_pcp'].includes(col.key) ? 'text-right' : ''} ${['emissao', 'op', 'c6_xrevm', 'tipo', 'item', 'status', 'lib_producao', 'entrega', 'ref_cliente', 'rev_cliente', 'data_pcp'].includes(col.key) ? 'text-center' : ''}`}
                                        >
                                            {renderCell(col.key, item)}
                                        </td>
                                    ))}
                                </tr>
                            ))
                        )}
                    </tbody>
                </table>
            </div>

            {/* Pagination */}
            {!loading && !error && orders.length > 0 && (
                <div className="p-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between print:hidden">
                    <span className="text-sm text-gray-500">
                        Página <span className="font-semibold text-gray-900">{page}</span> de <span className="font-semibold text-gray-900">{totalPages}</span>
                        {tipoFilter.length > 0 && <span className="ml-2 text-xs text-indigo-600 font-medium">({filteredOrders.length} itens filtrados por: {tipoFilter.join(', ')})</span>}
                    </span>
                    <div className="flex items-center gap-2">
                        <button onClick={() => setPage(p => Math.max(1, p - 1))} disabled={page === 1} className="p-2 rounded-lg hover:bg-white hover:shadow-sm disabled:opacity-50 disabled:cursor-not-allowed transition-all">
                            <ChevronLeft className="h-5 w-5 text-gray-600" />
                        </button>
                        <button onClick={() => setPage(p => Math.min(totalPages, p + 1))} disabled={page === totalPages} className="p-2 rounded-lg hover:bg-white hover:shadow-sm disabled:opacity-50 disabled:cursor-not-allowed transition-all">
                            <ChevronRight className="h-5 w-5 text-gray-600" />
                        </button>
                    </div>
                </div>
            )}

            {/* Column Settings Panel */}
            {showSettings && (
                <ColumnSettingsPanel
                    columns={colConfig}
                    onChange={setColConfig}
                    onClose={() => setShowSettings(false)}
                />
            )}

            {/* Modals */}
            {isDocsModalOpen && (
                <DocsModal
                    isOpen={isDocsModalOpen}
                    onClose={() => setIsDocsModalOpen(false)}
                    productCode={selectedProductForDocs.code}
                    productName={selectedProductForDocs.name}
                />
            )}
            {showImageModal && (
                <ProductImageModal
                    product={selectedProductForImage}
                    onClose={() => setShowImageModal(false)}
                    onSuccess={() => setShowImageModal(false)}
                />
            )}
            {notesTarget && (
                <NotesDrawer
                    isOpen={Boolean(notesTarget)}
                    onClose={() => setNotesTarget(null)}
                    orderId={notesTarget.order}
                    itemId={notesTarget.item}
                    productCode={notesTarget.product}
                />
            )}
            {engineeringTarget && (
                <EngineeringControlModal
                    isOpen={Boolean(engineeringTarget)}
                    onClose={() => setEngineeringTarget(null)}
                    orderId={engineeringTarget.orderId}
                    item={engineeringTarget.item}
                    onSave={handleSaveEngineeringControl}
                />
            )}
            {pcpForecastTarget && (
                <PCPForecastModal
                    isOpen={Boolean(pcpForecastTarget)}
                    onClose={() => setPcpForecastTarget(null)}
                    item={pcpForecastTarget}
                    onSaveSuccess={() => fetchData()}
                />
            )}
            {selectedInvoice && invoiceModalItem && (
                <InvoiceDetailsModal
                    isOpen={Boolean(selectedInvoice)}
                    onClose={() => { setSelectedInvoice(null); setInvoiceModalItem(null); }}
                    invoice={selectedInvoice}
                    item={invoiceModalItem}
                />
            )}
            {showReportModal && (
                <MeetingReportModal
                    isOpen={showReportModal}
                    onClose={() => setShowReportModal(false)}
                    globalFilters={filters}
                    isGlobal={isGlobalReport}
                />
            )}
            {pcpmetalOpen && (
                <PCPMetalDrawer
                    isOpen={pcpmetalOpen}
                    onClose={() => setPcpmetalOpen(false)}
                    context={pcpmetalContext}
                />
            )}
            {planModalTarget && (
                <EngineeringPlanModal
                    isOpen={Boolean(planModalTarget)}
                    onClose={() => setPlanModalTarget(null)}
                    pedido={planModalTarget.pedido}
                    item={planModalTarget.item}
                    currentDate={planModalTarget.currentDate}
                    currentObs={planModalTarget.currentObs}
                    onSave={(newData) => {
                        setOrders(prev => prev.map(o =>
                            (o.pedido === planModalTarget.pedido && o.item === planModalTarget.item)
                                ? { ...o, ...newData }
                                : o
                        ));
                    }}
                />
            )}
        </div>
    );
};

export default EngineeringOrdersPage;
</file>

<file path="client/src/pages/ProductStructure.jsx">
import React, { useState, useEffect, Fragment } from 'react';
import { useParams, useNavigate, useLocation } from 'react-router-dom';
import { ArrowLeft, Layers, Box, FileText, ChevronDown, ChevronRight, Printer, Download, Stamp } from 'lucide-react';
import { getEstruturaProduto, getStockBalance, getProductRoute, getFileUrl } from '../services/api';
import ProductDocuments from '../components/ProductDocuments';
import StockModal from '../components/StockModal';
import EngineeringReleaseModal from '../components/EngineeringReleaseModal';
import { generateEstruturaReport } from '../services/estruturaReportPdf';
import { generateMergedDrawingsPdf } from '../services/pdfMergerService';

const ProductStructure = () => {
    const { codigo } = useParams();
    const navigate = useNavigate();
    const location = useLocation();
    const [structure, setStructure] = useState([]);
    const [balances, setBalances] = useState({});
    const [loading, setLoading] = useState(true);
    const [isGeneratingPdf, setIsGeneratingPdf] = useState(false);
    const [isGeneratingPdfN1, setIsGeneratingPdfN1] = useState(false);
    const [error, setError] = useState(null);
    const [selectedProductForStock, setSelectedProductForStock] = useState(null);
    const [expandedRoutes, setExpandedRoutes] = useState({}); // Track which items have route expanded
    const [routes, setRoutes] = useState({}); // Store routes for each product
    const [showReleaseModal, setShowReleaseModal] = useState(false);

    const fetchStructure = async () => {
        try {
            const data = await getEstruturaProduto(codigo);
            setStructure(data);
            await fetchBalances(data);
        } catch (err) {
            setError('Não foi possível carregar a estrutura deste produto.');
        } finally {
            setLoading(false);
        }
    };

    const fetchBalances = async (items) => {
        const balancesMap = {};
        await Promise.all(items.map(async (item) => {
            try {
                const balanceData = await getStockBalance(item.codigo);
                balancesMap[item.codigo] = balanceData.saldo;
            } catch (e) {
                console.error(`Falha ao buscar saldo para ${item.codigo}`, e);
                balancesMap[item.codigo] = 0;
            }
        }));
        setBalances(balancesMap);
    };

    const toggleRoute = async (codigo) => {
        const key = codigo.trim();

        // If already expanded, just collapse
        if (expandedRoutes[key]) {
            setExpandedRoutes(prev => ({ ...prev, [key]: false }));
            return;
        }

        // If not fetched yet, fetch it
        if (!routes[key]) {
            try {
                const data = await getProductRoute(codigo);
                setRoutes(prev => ({ ...prev, [key]: Array.isArray(data) ? data : [] }));
            } catch (err) {
                console.error('Erro ao carregar roteiro:', err);
                setRoutes(prev => ({ ...prev, [key]: [] }));
            }
        }

        // Expand
        setExpandedRoutes(prev => ({ ...prev, [key]: true }));
    };

    useEffect(() => {
        if (codigo) {
            fetchStructure();
        }
    }, [codigo]);

    // Função para calcular indentação visual baseada no nível
    const getPadding = (nivel) => {
        return nivel * 24; // 24px por nível
    };

    // Determinar destino do botão voltar
    const handleBack = () => {
        if (location.state?.from) {
            navigate(location.state.from);
        } else {
            navigate(-1);
        }
    };

    const backLabel = 'Voltar';

    const handleDownloadDrawings = () => {
        generateMergedDrawingsPdf(structure, codigo);
    };

    const handleGeneratePDF = async () => {
        setIsGeneratingPdf(true);
        try {
            // Pré-busca roteiros de todos os itens em paralelo
            const allRoutesMap = { ...routes };
            const missing = structure.filter(item => !allRoutesMap[item.codigo?.trim()]);

            await Promise.all(missing.map(async (item) => {
                const key = item.codigo?.trim();
                try {
                    const data = await getProductRoute(item.codigo);
                    allRoutesMap[key] = Array.isArray(data) ? data : [];
                } catch {
                    allRoutesMap[key] = [];
                }
            }));

            // Atualiza o cache de roteiros na tela também
            setRoutes(allRoutesMap);

            await generateEstruturaReport(structure, allRoutesMap);

        } catch (err) {
            console.error('Erro ao gerar relatório:', err);
            alert('Falha ao gerar o relatório. Consulte o console para mais detalhes.');
        } finally {
            setIsGeneratingPdf(false);
        }
    };

    const handleGenerateNivel1PDF = async () => {
        setIsGeneratingPdfN1(true);
        try {
            // Somente nível 0 e nivel 1
            const filteredStructure = structure.filter(item => item.nivel === 0 || item.nivel === 1);

            const allRoutesMap = { ...routes };
            const missing = filteredStructure.filter(item => !allRoutesMap[item.codigo?.trim()]);

            await Promise.all(missing.map(async (item) => {
                const key = item.codigo?.trim();
                try {
                    const data = await getProductRoute(item.codigo);
                    allRoutesMap[key] = Array.isArray(data) ? data : [];
                } catch {
                    allRoutesMap[key] = [];
                }
            }));

            setRoutes(allRoutesMap);

            await generateEstruturaReport(filteredStructure, allRoutesMap, { 
                title: 'ESTRUTURA COMPACTA (NÍVEL 1) — MATR225Cus', 
                footerTitle: 'Estrutura Compacta (Nível 1)',
                isNivel1: true
            });

        } catch (err) {
            console.error('Erro ao gerar relatório N1:', err);
            alert('Falha ao gerar o relatório. Consulte o console para mais detalhes.');
        } finally {
            setIsGeneratingPdfN1(false);
        }
    };

    return (
        <div className="min-h-screen bg-gray-50 p-6 md:p-10">
            <div className="max-w-6xl mx-auto">
                <button
                    onClick={handleBack}
                    className="flex items-center text-gray-500 hover:text-blue-600 mb-6 transition-colors"
                >
                    <ArrowLeft className="h-4 w-4 mr-2" />
                    {backLabel}
                </button>

                <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-6">
                    <div className="p-6 border-b border-gray-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div>
                            <div className="flex items-center gap-3 mb-2">
                                <Layers className="h-6 w-6 text-blue-600" />
                                <h1 className="text-2xl font-bold text-gray-900">Estrutura do Produto</h1>
                            </div>
                            <p className="text-gray-500 font-mono bg-gray-100 inline-block px-2 py-1 rounded text-sm">
                                {codigo}
                            </p>
                        </div>

                        <div className="flex items-center gap-3">
                            <button
                                onClick={handleGenerateNivel1PDF}
                                disabled={isGeneratingPdfN1}
                                className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors shadow-sm ${isGeneratingPdfN1 ? 'bg-gray-100 text-gray-400 cursor-not-allowed border border-gray-200' : 'bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200'}`}
                            >
                                {isGeneratingPdfN1 ? (
                                    <div className="w-4 h-4 border-2 border-gray-300 border-t-amber-600 rounded-full animate-spin" />
                                ) : (
                                    <Layers className="h-4 w-4" />
                                )}
                                {isGeneratingPdfN1 ? 'Gerando...' : 'Nível 1'}
                            </button>
                            <button
                                onClick={handleGeneratePDF}
                                disabled={isGeneratingPdf}
                                className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-colors shadow-sm ${isGeneratingPdf ? 'bg-gray-100 text-gray-400 cursor-not-allowed border border-gray-200' : 'bg-white hover:bg-gray-50 text-gray-700 border border-gray-200'}`}
                            >
                                {isGeneratingPdf ? (
                                    <div className="w-4 h-4 border-2 border-gray-300 border-t-blue-600 rounded-full animate-spin" />
                                ) : (
                                    <Printer className="h-4 w-4" />
                                )}
                                {isGeneratingPdf ? 'Gerando PDF...' : 'Emitir Relatório'}
                            </button>
                            <button
                                onClick={async () => {
                                    // Pre-fetch all routes before opening modal
                                    const allRoutesMap = { ...routes };
                                    const missing = structure.filter(item => !allRoutesMap[item.codigo?.trim()]);
                                    await Promise.all(missing.map(async (it) => {
                                        const key = it.codigo?.trim();
                                        try {
                                            const data = await getProductRoute(it.codigo);
                                            allRoutesMap[key] = Array.isArray(data) ? data : [];
                                        } catch {
                                            allRoutesMap[key] = [];
                                        }
                                    }));
                                    setRoutes(allRoutesMap);
                                    setShowReleaseModal(true);
                                }}
                                className="flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-sm"
                            >
                                <Stamp className="h-4 w-4" />
                                Liberação
                            </button>
                            <button
                                onClick={handleDownloadDrawings}
                                className="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-sm"
                            >
                                <Download className="h-4 w-4" />
                                Baixar Desenhos
                            </button>
                            <button
                                onClick={() => navigate(`/bom/${encodeURIComponent(codigo)}`)}
                                className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-sm"
                            >
                                <FileText className="h-4 w-4" />
                                Lista de Materiais
                            </button>
                        </div>
                    </div>

                    <div className="overflow-x-auto">
                        <table className="w-full text-sm text-left">
                            <thead className="text-xs text-gray-500 uppercase bg-gray-50 border-b border-gray-100">
                                <tr>
                                    <th className="px-6 py-4 text-center">Nível</th>
                                    <th className="px-6 py-4">Código</th>
                                    <th className="px-6 py-4">Descrição</th>
                                    <th className="px-6 py-4">UM</th>
                                    <th className="px-6 py-4 text-right">Qtd Nec.</th>
                                    <th className="px-6 py-4">Ref. Cliente</th>
                                    <th className="px-6 py-4 text-center">Roteiro</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-gray-50">
                                {loading && (
                                    <tr>
                                        <td colSpan="8" className="p-8 text-center">
                                            <div className="inline-block h-8 w-8 animate-spin rounded-full border-4 border-blue-600 border-t-transparent"></div>
                                        </td>
                                    </tr>
                                )}

                                {error && (
                                    <tr>
                                        <td colSpan="8" className="p-8 text-center text-red-500 font-medium">
                                            {error}
                                        </td>
                                    </tr>
                                )}

                                {!loading && !error && structure.map((item, idx) => (
                                    <Fragment key={idx}>
                                        <tr className={`hover:bg-slate-50 transition-colors ${item.nivel === 0 ? 'bg-blue-50/30' : ''}`}>
                                            
                                            {/* Nível */}
                                            <td className="px-6 py-3 text-center">
                                                <span className={`
                                                inline-flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold
                                                ${item.nivel === 0 ? 'bg-blue-100 text-blue-700' : 'bg-gray-100 text-gray-600'}
                                            `}>
                                                    {item.nivel}
                                                </span>
                                            </td>
                                            
                                            {/* Código */}
                                            <td className="px-6 py-3 font-mono text-xs text-gray-600">
                                                {item.codigo}
                                            </td>
                                            
                                            {/* Descrição (Componente / Estrutura) */}
                                            <td className="px-6 py-3">
                                                <div
                                                    className="flex items-center gap-2"
                                                    style={{ paddingLeft: `${getPadding(item.nivel)}px` }}
                                                >
                                                    {item.nivel > 0 && (
                                                        <div className="w-4 h-px bg-gray-300 mr-1"></div>
                                                    )}

                                                    {/* ICON LOGIC */}
                                                    {item.nivel === 0 ? (
                                                        <Box className="h-4 w-4 text-blue-600 shrink-0" />
                                                    ) : item.tem_arquivos ? (
                                                        // HAS PDF -> RED ICON + CLICK
                                                        <button
                                                            onClick={(e) => {
                                                                e.stopPropagation();
                                                                if (item.primeiro_arquivo) {
                                                                    window.open(getFileUrl(`/api/docs/view?path=${encodeURIComponent(item.primeiro_arquivo)}`), '_blank');
                                                                }
                                                            }}
                                                            className="hover:bg-red-50 p-0.5 rounded transition-colors"
                                                            title="Abrir Desenho/PDF"
                                                        >
                                                            <FileText className="h-4 w-4 text-red-500 shrink-0" />
                                                        </button>
                                                    ) : (
                                                        // NO PDF -> GRAY ICON
                                                        <FileText className="h-4 w-4 text-gray-300 shrink-0" />
                                                    )}

                                                    <span className={`font-medium ${item.nivel === 0 ? 'text-blue-700' : 'text-gray-700'}`}>
                                                        {item.descricao || '(Sem Descrição)'}
                                                    </span>
                                                </div>
                                            </td>

                                            {/* Unidade (UM) */}
                                            <td className="px-6 py-3 text-gray-500">
                                                {item.unidade}
                                            </td>

                                            {/* Qtd Nec. */}
                                            <td className="px-6 py-3 text-right font-mono font-medium">
                                                {(parseFloat(item.qtd_necessaria) || 0).toLocaleString('pt-BR', { maximumFractionDigits: 4 })}
                                            </td>
                                            
                                            {/* Ref. Cliente */}
                                            <td className="px-6 py-3 text-sm text-gray-600">
                                                {item.referencias && item.referencias.length > 0 ? (
                                                    <div className="flex flex-col gap-1">
                                                        {item.referencias.map((ref, idx) => (
                                                            <div key={idx} className="bg-yellow-50 px-2 py-0.5 rounded border border-yellow-100 w-fit">
                                                                <span className="font-mono font-bold text-gray-800 text-xs">{ref.desenho}</span>
                                                            </div>
                                                        ))}
                                                    </div>
                                                ) : (
                                                    <span className="text-gray-300">-</span>
                                                )}
                                            </td>

                                            {/* Roteiro */}
                                            <td className="px-6 py-3 text-center">
                                                <button
                                                    onClick={() => toggleRoute(item.codigo)}
                                                    className="p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded transition-all"
                                                    title="Ver Roteiro"
                                                >
                                                    {expandedRoutes[item.codigo.trim()] ? (
                                                        <ChevronDown className="h-4 w-4" />
                                                    ) : (
                                                        <ChevronRight className="h-4 w-4" />
                                                    )}
                                                </button>
                                            </td>
                                        </tr>

                                        {/* Route Details Row */}
                                        {expandedRoutes[item.codigo.trim()] && (
                                            <tr className="bg-slate-50">
                                                <td colSpan="8" className="px-6 py-4">
                                                    <div className="pl-8">
                                                        <div className="text-xs font-semibold text-gray-500 uppercase mb-2">Roteiro de Fabricação</div>
                                                        {!routes[item.codigo.trim()] || routes[item.codigo.trim()].length === 0 ? (
                                                            <div className="text-sm text-gray-400 italic">Sem roteiro cadastrado</div>
                                                        ) : (
                                                            <table className="min-w-full text-xs">
                                                                <thead>
                                                                    <tr className="text-gray-500">
                                                                        <th className="text-left py-2 pr-4">Op</th>
                                                                        <th className="text-left py-2 pr-4">Descrição</th>
                                                                        <th className="text-left py-2 pr-4">Recurso</th>
                                                                        <th className="text-right py-2 pr-4">Setup (min)</th>
                                                                        <th className="text-right py-2">Tempo Padrão (min)</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody className="text-gray-700">
                                                                    {routes[item.codigo.trim()].map((op, opIdx) => (
                                                                        <tr key={opIdx} className="border-t border-gray-200">
                                                                            <td className="py-2 pr-4 font-mono font-bold text-blue-600">{op.operacao}</td>
                                                                            <td className="py-2 pr-4">{op.descricao?.trim() || '-'}</td>
                                                                            <td className="py-2 pr-4 font-mono">{op.recurso?.trim() || '-'}</td>
                                                                            <td className="py-2 pr-4 text-right font-mono">{op.tempo_setup || '0'}</td>
                                                                            <td className="py-2 text-right font-mono font-medium">{op.tempo_padrao || '0'}</td>
                                                                        </tr>
                                                                    ))}
                                                                </tbody>
                                                            </table>
                                                        )}
                                                    </div>
                                                </td>
                                            </tr>
                                        )}
                                    </Fragment>
                                ))}

                                {!loading && !error && structure.length === 0 && (
                                    <tr>
                                        <td colSpan="8" className="p-8 text-center text-gray-500">
                                            Nenhum item encontrado na estrutura (BOM).
                                            <br />
                                            <span className="text-xs text-gray-400">Verifique se o produto possui cadastro na SG1.</span>
                                        </td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>

                {/* Seção de Documentos - Integrada com MySQL externo */}
                <ProductDocuments produtoCodigo={codigo} />

                {/* Modal de Estoque */}
                <StockModal
                    isOpen={!!selectedProductForStock}
                    onClose={() => {
                        setSelectedProductForStock(null);
                        // Refresh balances when modal closes
                        fetchBalances(structure);
                    }}
                    productCode={selectedProductForStock?.codigo}
                    productName={selectedProductForStock?.descricao}
                />

                {/* Modal de Liberação de Engenharia */}
                <EngineeringReleaseModal
                    isOpen={showReleaseModal}
                    onClose={() => setShowReleaseModal(false)}
                    structure={structure}
                    routesMap={routes}
                    codigo={codigo}
                />
            </div>
        </div>
    );
};

export default ProductStructure;
</file>

<file path="client/src/pages/Romaneios.jsx">
import React, { useState, useEffect } from 'react';
import { Plus, Truck, Search, Eye, Trash2, Filter, Edit, Printer, FolderPlus, FolderOpen, FileText } from 'lucide-react';
import { getRomaneios, deleteRomaneio, updateRomaneioStatus, createRomaneioFolder, getRomaneioBaseDirConfig, downloadRomaneioBundle, searchRomaneioItems } from '../services/api';
import RomaneioForm from '../components/RomaneioForm';
import RomaneioEmailModal from '../components/RomaneioModals/RomaneioEmailModal';
import useStickyState from '../hooks/useStickyState';
import { useAuth } from '../contexts/AuthContext';

export default function Romaneios() {
    const { user } = useAuth();
    const [view, setView] = useStickyState('list', '@metalfisa:roma_view'); // list | form
    const [romaneios, setRomaneios] = useState([]);
    const [selectedId, setSelectedId] = useStickyState(null, '@metalfisa:roma_selectedId');
    const [initialStep, setInitialStep] = useState(1);
    const [formKey, setFormKey] = useState(0);
    const [loading, setLoading] = useState(false);
    
    // Email Modal State
    const [emailModal, setEmailModal] = useState({ isOpen: false, romaneio: null });

    // Filters
    const [filters, setFilters] = useStickyState({
        search: '',
        status: '',
        startDate: '',
        endDate: ''
    }, '@metalfisa:roma_filters');

    useEffect(() => {
        if (view === 'list') fetchRomaneios();
    }, [view, filters]); // Reload when filters change (debouncing might be needed for text, but simple for now)

    const fetchRomaneios = async () => {
        setLoading(true);
        try {
            const data = await getRomaneios(filters);
            setRomaneios(data);
        } catch (err) {
            console.error(err);
        } finally {
            setLoading(false);
        }
    };

    const handleCreate = () => {
        setSelectedId(null);
        setInitialStep(1);
        setFormKey(k => k + 1);
        setView('form');
    };

    const handleEdit = (id) => {
        setSelectedId(id);
        setInitialStep(1);
        setFormKey(k => k + 1);
        setView('form');
    };

    const handleView = (id) => {
        setSelectedId(id);
        setInitialStep(2);
        setFormKey(k => k + 1);
        setView('form');
    };

    const handleDelete = async (id) => {
        if (!window.confirm('Tem certeza que deseja excluir este romaneio?')) return;
        try {
            await deleteRomaneio(id);
            fetchRomaneios();
        } catch (err) {
            alert('Erro ao excluir: ' + err.message);
        }
    };

    const handleSuccess = () => {
        setView('list');
        fetchRomaneios();
    };

    const handleCreateFolder = async () => {
        if (!selectedId) return;
        try {
            const res = await createRomaneioFolder(selectedId);
            alert(res.message);
        } catch (err) {
            alert(err.response?.data?.error || 'Erro inesperado ao criar pasta');
        }
    };

    const handleOpenFolder = async () => {
        if (!selectedId) return;
        try {
            const { baseDir } = await getRomaneioBaseDirConfig();
            
            const uncPath = `${baseDir}\\RO-${selectedId}`;
            const fileUrl = `file:///${uncPath.replace(/\\/g, '/')}`;
            
            navigator.clipboard.writeText(uncPath).then(() => {
                alert(`O atalho da rede foi copiado para sua área de transferência!\n\n${uncPath}\n\nCaso o navegador não abra a pasta automaticamente (por política de segurança do Chrome/Edge), basta apertar Win+E e colar no campo de cima.`);
                window.open(fileUrl, '_blank');
            }).catch(() => {
                alert(`O endereço da pasta do romaneio é:\n\n${uncPath}\n\nVocê pode copiá-lo e colar no seu Windows Explorer (Win+E).`);
            });
        } catch (err) {
            alert('Erro ao buscar o diretório base configurado: ' + err.message);
        }
    };

    return (
        <div className="space-y-6">
            <div className="flex justify-between items-center">
                <div>
                    <h2 className="text-2xl font-bold tracking-tight text-slate-900 flex items-center gap-2">
                        <Truck className="w-8 h-8 text-blue-600" />
                        Romaneios de Saída
                    </h2>
                    <p className="text-slate-500">Gestão de envios de material (Entrega, Manutenção, etc).</p>
                </div>
                {view === 'list' && (
                    <div className="flex gap-2">
                        <button
                            onClick={() => setView('product_search')}
                            className="text-slate-600 bg-white border border-slate-300 px-4 py-2 rounded-lg flex items-center gap-2 hover:bg-slate-50 shadow-sm"
                        >
                            <Search className="w-4 h-4" />
                            Localizar Produto
                        </button>
                        <button
                            onClick={handleCreate}
                            className="bg-blue-600 text-white px-4 py-2 rounded-lg flex items-center gap-2 hover:bg-blue-700 shadow-sm"
                        >
                            <Plus className="w-4 h-4" />
                            Novo Romaneio
                        </button>
                    </div>
                )}
                {(view === 'form' || view === 'product_search') && (
                    <div className="flex items-center gap-4 border border-red-500 border-0">
                        {view === 'form' && selectedId && (
                            <button
                                onClick={() => document.getElementById('btn-print-romaneio')?.click()}
                                className="bg-slate-800 text-white hover:bg-slate-900 px-4 py-2 rounded-lg flex items-center gap-2 font-medium shadow-sm transition"
                            >
                                <Printer className="w-4 h-4" />
                                Imprimir Romaneio
                            </button>
                        )}
                        {view === 'form' && selectedId && (
                            <button
                                onClick={handleOpenFolder}
                                className="bg-emerald-100 text-emerald-800 hover:bg-emerald-200 border border-emerald-300 px-4 py-2 rounded-lg flex items-center gap-2 font-medium shadow-sm transition"
                                title="Abrir a pasta do romaneio na rede ou copiar o caminho"
                            >
                                <FolderOpen className="w-4 h-4" />
                                Acessar Pasta da Rede
                            </button>
                        )}
                        {view === 'form' && selectedId && (
                            <button
                                onClick={handleCreateFolder}
                                className="bg-amber-100 text-amber-800 hover:bg-amber-200 border border-amber-300 px-4 py-2 rounded-lg flex items-center gap-2 font-medium shadow-sm transition"
                                title="Forçar a criação da pasta na rede caso ainda não exista"
                            >
                                <FolderPlus className="w-4 h-4" />
                                Criar Pasta na Rede
                            </button>
                        )}
                        {view === 'form' && selectedId && (
                            <button
                                onClick={() => handleEdit(selectedId)}
                                className="text-blue-600 border border-blue-200 bg-blue-50 px-4 py-2 rounded-lg hover:bg-blue-100 font-medium flex items-center gap-2 transition"
                            >
                                <Edit className="w-4 h-4" />
                                Editar Dados Principais do Romaneio
                            </button>
                        )}
                        <button
                            onClick={() => setView('list')}
                            className="bg-slate-200 text-slate-700 px-4 py-2 rounded-lg hover:bg-slate-300 font-medium whitespace-nowrap transition"
                        >
                            Voltar para Lista de Romaneios
                        </button>
                    </div>
                )}
            </div>

            {/* Product Search View */}
            {view === 'product_search' && <ProductSearch />}

            {/* Filters Bar */}
            {view === 'list' && (
                <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap gap-4 items-end">
                    <div className="flex-1 min-w-[200px]">
                        <label className="block text-xs font-bold text-slate-500 mb-1">Buscar (Fornecedor/ID)</label>
                        <div className="relative">
                            <Search className="w-4 h-4 absolute left-3 top-3 text-slate-400" />
                            <input
                                className="w-full pl-10 p-2 border rounded-lg text-sm"
                                placeholder="Nome do fornecedor ou ID..."
                                value={filters.search}
                                onChange={e => setFilters({ ...filters, search: e.target.value })}
                            />
                        </div>
                    </div>
                    <div className="w-40">
                        <label className="block text-xs font-bold text-slate-500 mb-1">Status</label>
                        <select
                            className="w-full p-2 border rounded-lg text-sm"
                            value={filters.status}
                            onChange={e => setFilters({ ...filters, status: e.target.value })}
                        >
                            <option value="">Todos</option>
                            <option value="Rascunho">Rascunho</option>
                            <option value="Finalizado">Finalizado</option>
                            <option value="Enviado">Enviado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                    <div className="w-32">
                        <label className="block text-xs font-bold text-slate-500 mb-1">Data Liberação (De)</label>
                        <input
                            type="date"
                            className="w-full p-2 border rounded-lg text-sm"
                            value={filters.startDate}
                            onChange={e => setFilters({ ...filters, startDate: e.target.value })}
                        />
                    </div>
                    <div className="w-32">
                        <label className="block text-xs font-bold text-slate-500 mb-1">Data Liberação (Até)</label>
                        <input
                            type="date"
                            className="w-full p-2 border rounded-lg text-sm"
                            value={filters.endDate}
                            onChange={e => setFilters({ ...filters, endDate: e.target.value })}
                        />
                    </div>
                    <div className="flex gap-2">
                        <button
                            onClick={() => setFilters({ search: '', status: '', startDate: '', endDate: '' })}
                            className="p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg"
                            title="Limpar Filtros"
                        >
                            <Filter className="w-4 h-4" />
                        </button>
                    </div>
                </div>
            )}

            {view === 'list' ? (
                <div className="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <table className="w-full text-left text-sm">
                        <thead className="bg-slate-50 text-slate-500 font-medium uppercase text-xs">
                            <tr>
                                <th className="p-4">ID</th>
                                <th className="p-4">Rev</th>
                                <th className="p-4">Cliente</th>
                                <th className="p-4">Tipo</th>
                                <th className="p-4">Liberação</th>
                                <th className="p-4">Prev. Retorno</th>
                                <th className="p-4">Peso (kg)</th>
                                <th className="p-4">Área (m²)</th>
                                <th className="p-4">Qtd Enviada</th>
                                <th className="p-4">Qtd Recebida</th>
                                <th className="p-4">Status</th>
                                <th className="p-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-100">
                            {loading ? (
                                <tr><td colSpan="10" className="p-8 text-center text-slate-400">Carregando...</td></tr>
                            ) : !Array.isArray(romaneios) || romaneios.length === 0 ? (
                                <tr><td colSpan="10" className="p-8 text-center text-slate-400">Nenhum romaneio encontrado.</td></tr>
                            ) : (
                                romaneios.map(r => (
                                    <tr key={r.id} className="hover:bg-slate-50">
                                        <td className="p-4 font-mono text-slate-600">#{r.id}</td>
                                        <td className="p-4 font-mono text-slate-500 text-xs">v{r.current_revision || 1}</td>
                                        <td className="p-4 font-medium text-slate-900">
                                            {r.cliente_nome}
                                            <div className="text-xs text-slate-400 font-normal">Loja {r.cliente_loja}</div>
                                        </td>
                                        <td className="p-4">
                                            <span className="bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs">{r.tipo_descricao}</span>
                                        </td>
                                        <td className="p-4 text-slate-600 font-medium text-sm">
                                            {r.data_liberacao ? new Date(r.data_liberacao).toLocaleDateString() : '-'}
                                        </td>
                                        <td className="p-4 text-slate-600 font-medium text-sm">
                                            {r.data_previsao_retorno ? new Date(r.data_previsao_retorno).toLocaleDateString() : '-'}
                                        </td>
                                        <td className="p-4 text-slate-600 font-bold text-sm">
                                            {Number(r.peso_total || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
                                        </td>
                                        <td className="p-4 text-slate-600 font-bold text-sm">
                                            {Number(r.area_pintura_total || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
                                        </td>
                                        <td className="p-4 text-slate-600 text-sm">
                                            {Number(r.total_enviado || 0)}
                                        </td>
                                        <td className={`p-4 font-bold text-sm ${Number(r.total_recebido) > 0 && Number(r.total_recebido) >= Number(r.total_enviado) ? 'text-green-600' : 'text-slate-600'}`}>
                                            {Number(r.total_recebido || 0)}
                                        </td>
                                        <td className="p-4">
                                            <select
                                                className={`px-2 py-1 rounded text-xs font-medium border-0 cursor-pointer outline-none focus:ring-2 focus:ring-blue-200
                                                    ${r.status === 'Rascunho' ? 'bg-yellow-50 text-yellow-700' : ''}
                                                    ${r.status === 'Finalizado' ? 'bg-green-50 text-green-700' : ''}
                                                    ${r.status === 'Enviado' ? 'bg-blue-50 text-blue-700' : ''}
                                                    ${r.status === 'Cancelado' ? 'bg-red-50 text-red-700' : ''}
                                                `}
                                                value={r.status}
                                                onChange={async (e) => {
                                                    const newStatus = e.target.value;
                                                    
                                                    const today = new Date().toLocaleDateString('pt-BR');
                                                    const userDate = window.prompt(`Informe a data da alteração para o status "${newStatus}" (DD/MM/AAAA):`, today);
                                                    
                                                    if (userDate === null) {
                                                        // User cancelled, revert visually
                                                        e.target.value = r.status;
                                                        return;
                                                    }
                                                    
                                                    try {
                                                        const userName = user?.nome || user?.login || 'Sistema';
                                                        await updateRomaneioStatus(r.id, newStatus, userDate, userName);
                                                        fetchRomaneios();
                                                        
                                                        // Trigger Email Modal
                                                        if (['Finalizado', 'Enviado', 'Cancelado'].includes(newStatus)) {
                                                            setEmailModal({ isOpen: true, romaneio: r });
                                                        }
                                                    } catch (err) {
                                                        alert('Erro ao mudar status: ' + (err.response?.data?.error || err.message));
                                                        fetchRomaneios();
                                                    }
                                                }}
                                                onClick={(e) => e.stopPropagation()}
                                            >
                                                <option value="Rascunho">Rascunho</option>
                                                <option value="Finalizado">Finalizado</option>
                                                <option value="Enviado">Enviado</option>
                                                <option value="Cancelado">Cancelado</option>
                                            </select>
                                        </td>
                                        <td className="p-4 text-right flex justify-end gap-2">
                                            <button
                                                onClick={() => handleView(r.id)}
                                                className="text-blue-600 hover:bg-blue-50 p-2 rounded-lg transition-colors"
                                                title="Ver Detalhes"
                                            >
                                                <Eye className="w-4 h-4" />
                                            </button>
                                            <button
                                                onClick={() => handleEdit(r.id)}
                                                className="text-slate-600 hover:bg-slate-100 p-2 rounded-lg transition-colors"
                                                title="Editar Cabeçalho"
                                            >
                                                <Edit className="w-4 h-4" />
                                            </button>
                                            <button
                                                onClick={() => handleDelete(r.id)}
                                                className="text-red-600 hover:bg-red-50 p-2 rounded-lg transition-colors"
                                                title="Excluir"
                                            >
                                                <Trash2 className="w-4 h-4" />
                                            </button>
                                        </td>
                                    </tr>
                                ))
                            )}
                        </tbody>
                    </table>
                </div>
            ) : view === 'form' ? (
                <RomaneioForm
                    key={formKey}
                    romaneioId={selectedId}
                    initialStep={initialStep}
                    onSuccess={handleSuccess}
                />
            ) : null}

            {/* Email Modal */}
            <RomaneioEmailModal 
                isOpen={emailModal.isOpen}
                onClose={() => setEmailModal({ isOpen: false, romaneio: null })}
                romaneio={emailModal.romaneio}
            />
        </div>
    );
}


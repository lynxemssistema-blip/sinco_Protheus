        print("\nServidor rodando (Multi-Thread)... Pressione CTRL+C para parar\n")
        server.serve_forever()
    except OSError as e:
        if e.errno == 10048: # Address already in use (Windows)
            print(f"\n[ERRO CRITICO] A porta {PORT} ja esta em uso!")
            print("Solucao 1: Feche o programa que esta usando esta porta.")
            print("Solucao 2: Execute em outra porta. Ex: python agent.py 8081")
        else:
            print(f"\n[ERRO] Falha ao iniciar servidor: {e}")
    except KeyboardInterrupt:
        print("\n\nEncerrando servidor...")
        try:
            server.shutdown()
        except:
            pass
</file>

<file path="client/src/components/FloatingAvisos.jsx">
import React, { useState, useEffect } from 'react';
import { useAuth } from '../contexts/AuthContext';
import { MessageSquare, CheckCircle, Reply } from 'lucide-react';
import api from '../services/api';
import { useLocation } from 'react-router-dom';

const FloatingAvisos = () => {
    const location = useLocation();
    const isAvisosPage = location.pathname === '/avisos';
    const { user, signed } = useAuth();
    const [avisos, setAvisos] = useState([]);
    const [currentIndex, setCurrentIndex] = useState(0);
    const [replying, setReplying] = useState(false);
    const [replyText, setReplyText] = useState('');

    const fetchAvisos = async () => {
        if (!signed || !user?.id) return;
        try {
            const token = localStorage.getItem('@metalfisa:token');
            const res = await api.get(`/avisos/nao-concluidos/${user.id}`, {
                headers: { Authorization: `Bearer ${token}` }
            });
            setAvisos(res.data);
            if (currentIndex >= res.data.length && res.data.length > 0) {
                setCurrentIndex(res.data.length - 1);
            }
        } catch (error) {
            console.error('Erro ao buscar avisos', error);
        }
    };

    useEffect(() => {
        if (!signed || !user?.id) return;

        // Busca imediata ao carregar a página
        fetchAvisos();

        // Polling leve a cada 30s como fallback
        const intervalId = setInterval(fetchAvisos, 30000);

        // ==== TEMPO REAL (SOCKET.IO) - lazy import para evitar Illegal constructor ====
        let socket = null;
        import('socket.io-client').then(({ io }) => {
            socket = io(window.location.origin, { transports: ['websocket', 'polling'] });

            socket.on('connect', () => {
                socket.emit('join_user', user.id);
            });

            socket.on('novo_aviso', (novoData) => {
                if (window.location.pathname === '/avisos') return;
                setAvisos(prev => [...prev, novoData]);
            });
        }).catch(err => console.error('Socket.io load error:', err));

        return () => {
            clearInterval(intervalId);
            if (socket) socket.disconnect();
        };
    }, [user?.id, signed]);

    // Limpa os avisos flutuantes se o usuário entrar na página de histórico/chat
    useEffect(() => {
        if (isAvisosPage && avisos.length > 0) {
            setAvisos([]);
        }
    }, [isAvisosPage, avisos.length]);

    const handleConcluir = async (idAviso) => {
        try {
            const token = localStorage.getItem('@metalfisa:token');
            await api.put(`/avisos/${idAviso}/concluir`, {}, {
                headers: { Authorization: `Bearer ${token}` }
            });

            // Remove localmente p/ interface
            setAvisos(prev => prev.filter(a => a.idAviso !== idAviso));
            if (currentIndex > 0) setCurrentIndex(p => p - 1);
        } catch (error) {
            console.error('Erro ao concluir aviso', error);
        }
    };

    const handleReply = async (aviso) => {
        if (!replyText.trim()) return;
        try {
            const token = localStorage.getItem('@metalfisa:token');
            await api.post('/avisos', {
                idRemetente: user.id,
                idDestinatario: aviso.idRemetente,
                mensagem: replyText,
                idRespostaDe: aviso.idAviso
            }, {
                headers: { Authorization: `Bearer ${token}` }
            });

            await handleConcluir(aviso.idAviso);
            setReplying(false);
            setReplyText('');
        } catch (error) {
            console.error('Erro ao responder aviso', error);
        }
    };

    if (!signed || avisos.length === 0 || isAvisosPage) return null;

    const avisoAtual = avisos[currentIndex];

    return (
        <div className="fixed bottom-6 right-6 z-50 animate-bounce-short">
            <div className="bg-white rounded-lg shadow-2xl border-l-4 border-blue-500 w-80 md:w-96 overflow-hidden flex flex-col pointer-events-auto">
                {/* Header do Aviso */}
                <div className="bg-slate-50 p-3 border-b flex items-center justify-between">
                    <div className="flex items-center gap-2 text-slate-700">
                        <MessageSquare className="w-5 h-5 text-blue-500" />
                        <span className="font-bold text-sm">Novo Aviso de {avisoAtual.nomeRemetente}</span>
                    </div>
                </div>

                {/* Corpo do Aviso */}
                <div className="p-4 bg-white min-h-[80px]">
                    <p className="text-sm text-slate-800 break-words whitespace-pre-wrap">
                        {avisoAtual.mensagem}
                    </p>
                    <div className="text-[10px] text-slate-400 mt-2 text-right">
                        Enviado em: {new Date(avisoAtual.data_envio).toLocaleString('pt-BR')}
                    </div>
                </div>

                {/* Resposta */}
                {replying && (
                    <div className="px-4 pb-2">
                        <textarea
                            className="w-full text-sm border p-2 rounded focus:ring-1 focus:ring-blue-500 outline-none"
                            rows={3}
                            placeholder="Escreva sua resposta..."
                            value={replyText}
                            onChange={(e) => setReplyText(e.target.value)}
                        />
                    </div>
                )}

                {/* Ações */}
                <div className="p-3 bg-slate-50 border-t flex items-center justify-between">
                    <div className="text-xs text-slate-500 font-medium">
                        {avisos.length > 1 && (
                            <span>{currentIndex + 1} de {avisos.length}</span>
                        )}
                    </div>
                    <div className="flex gap-2">
                        {replying ? (
                            <>
                                <button
                                    onClick={() => setReplying(false)}
                                    className="px-3 py-1.5 text-xs font-semibold text-slate-600 border border-slate-300 rounded hover:bg-slate-100"
                                >
                                    Cancelar
                                </button>
                                <button
                                    onClick={() => handleReply(avisoAtual)}
                                    className="px-3 py-1.5 text-xs font-semibold text-white bg-blue-500 rounded hover:bg-blue-600"
                                >
                                    Enviar
                                </button>
                            </>
                        ) : (
                            <>
                                <button
                                    onClick={() => setReplying(true)}
                                    className="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 rounded"
                                >
                                    <Reply className="w-3 h-3" />
                                    Responder
                                </button>
                                <button
                                    onClick={() => handleConcluir(avisoAtual.idAviso)}
                                    className="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-green-500 hover:bg-green-600 rounded"
                                >
                                    <CheckCircle className="w-3 h-3" />
                                    Concluir
                                </button>
                            </>
                        )}
                    </div>
                </div>

                {/* Navegação entre múltiplos */}
                {avisos.length > 1 && !replying && (
                    <div className="flex bg-slate-100">
                        <button
                            disabled={currentIndex === 0}
                            onClick={() => setCurrentIndex(p => p - 1)}
                            className="flex-1 py-1 text-xs text-center border-r hover:bg-slate-200 disabled:opacity-50"
                        >
                            Anterior
                        </button>
                        <button
                            disabled={currentIndex === avisos.length - 1}
                            onClick={() => setCurrentIndex(p => p + 1)}
                            className="flex-1 py-1 text-xs text-center hover:bg-slate-200 disabled:opacity-50"
                        >
                            Próximo
                        </button>
                    </div>
                )}
            </div>
        </div>
    );
};

export default FloatingAvisos;
</file>

<file path="client/src/components/HelpDrawer.jsx">
import React from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import {
    X, HelpCircle, ChevronRight, ArrowRight, Lightbulb,
    BookOpen, ExternalLink, List, Zap, Pin, PinOff
} from 'lucide-react';
import { useHelp } from '../contexts/HelpContext';

// ─── Icon Map ────────────────────────────────────────────────────────────────
const ICON_BG = {
    'Comercial': { bg: 'bg-blue-100', text: 'text-blue-700', border: 'border-blue-200' },
    'PCP': { bg: 'bg-amber-100', text: 'text-amber-700', border: 'border-amber-200' },
    'Engenharia': { bg: 'bg-teal-100', text: 'text-teal-700', border: 'border-teal-200' },
    'SINCO / Engenharia': { bg: 'bg-cyan-100', text: 'text-cyan-700', border: 'border-cyan-200' },
    'Materiais': { bg: 'bg-emerald-100', text: 'text-emerald-700', border: 'border-emerald-200' },
    'Compras': { bg: 'bg-orange-100', text: 'text-orange-700', border: 'border-orange-200' },
    'Produtos': { bg: 'bg-teal-100', text: 'text-teal-700', border: 'border-teal-200' },
    'Logística': { bg: 'bg-red-100', text: 'text-red-700', border: 'border-red-200' },
    'SGQ': { bg: 'bg-teal-100', text: 'text-teal-700', border: 'border-teal-200' },
    'Relatórios': { bg: 'bg-indigo-100', text: 'text-indigo-700', border: 'border-indigo-200' },
    'Administração': { bg: 'bg-slate-100', text: 'text-slate-700', border: 'border-slate-200' },
    'Comunicação': { bg: 'bg-yellow-100', text: 'text-yellow-700', border: 'border-yellow-200' },
    'Analytics': { bg: 'bg-sky-100', text: 'text-sky-700', border: 'border-sky-200' },
};

function getCategoryStyle(category) {
    return ICON_BG[category] || { bg: 'bg-gray-100', text: 'text-gray-700', border: 'border-gray-200' };
}

// ─── Main Component ──────────────────────────────────────────────────────────
export default function HelpDrawer() {
    const { isOpen, forcedPath, closeHelp, isPinned, togglePin, getHelpByPath, allModules = [], loadingHelp } = useHelp();
    const location = useLocation();
    const navigate = useNavigate();
    const drawerRef = React.useRef(null);

    const [activeTabId, setActiveTabId] = React.useState(null);

    const currentPath = forcedPath || location.pathname;
    
    // Memoize helpData to avoid unnecessary re-renders
    const helpData = React.useMemo(() => {
        try {
            return getHelpByPath ? getHelpByPath(currentPath) : null;
        } catch (err) {
            console.error('Error in getHelpByPath:', err);
            return null;
        }
    }, [currentPath, getHelpByPath]);

    // Initial tab selection and reset logic
    React.useEffect(() => {
        if (helpData?.tabs && Array.isArray(helpData.tabs) && helpData.tabs.length > 0) {
            if (!activeTabId || !helpData.tabs.some(t => t?.id === activeTabId)) {
                setActiveTabId(helpData.tabs[0].id);
            }
        } else {
            setActiveTabId(null);
        }
    }, [helpData, activeTabId]);

    const activeTab = React.useMemo(() => {
        return helpData?.tabs?.find(t => t?.id === activeTabId);
    }, [helpData, activeTabId]);
    
    const content = activeTab || helpData;
    
    // Safely get category style
    const categoryName = helpData?.category || 'Central';
    const categoryStyle = React.useMemo(() => getCategoryStyle(categoryName), [categoryName]);

    // Close on Escape
    React.useEffect(() => {
        const onKey = (e) => { if (e.key === 'Escape') closeHelp(); };
        if (isOpen) window.addEventListener('keydown', onKey);
        return () => window.removeEventListener('keydown', onKey);
    }, [isOpen, closeHelp]);

    // Handle outside clicks
    React.useEffect(() => {
        const onClickOutside = (e) => {
            if (isOpen && !isPinned && drawerRef.current && !drawerRef.current.contains(e.target)) {
                closeHelp();
            }
        };
        if (isOpen && !isPinned) {
            const t = setTimeout(() => document.addEventListener('mousedown', onClickOutside), 100);
            return () => { clearTimeout(t); document.removeEventListener('mousedown', onClickOutside); };
        }
    }, [isOpen, isPinned, closeHelp]);

    const handleNavigate = (path) => {
        navigate(path);
        closeHelp();
    };

    if (!isOpen && !isPinned) return null;

    return (
        <>
            {/* Backdrop */}
            <div
                className={`fixed inset-0 bg-black/20 backdrop-blur-[2px] z-[998] transition-opacity duration-300 ${(isOpen && !isPinned) ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
                aria-hidden="true"
                onClick={closeHelp}
            />

            {/* Drawer */}
            <aside
                ref={drawerRef}
                role="dialog"
                aria-modal="true"
                aria-label="Central de Ajuda"
                className={`fixed right-0 top-0 h-full w-full max-w-[420px] bg-white shadow-2xl z-[999] flex flex-col transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] ${isOpen ? 'translate-x-0' : 'translate-x-full'}`}
            >
                {/* Header */}
                <div className="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-slate-900 text-white flex-shrink-0">
                    <div className="flex items-center gap-3">
                        <div className="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center">
                            <HelpCircle className="h-4 w-4 text-white" />
                        </div>
                        <div>
                            <p className="text-[10px] uppercase tracking-widest text-slate-400 font-bold">Ajuda Contextual</p>
                            <h2 className="text-sm font-black tracking-tight leading-tight truncate max-w-[200px]">
                                {helpData?.title || 'Central de Ajuda'}
                            </h2>
                        </div>
                    </div>
                    <div className="flex items-center gap-2">
                        <button
                            onClick={togglePin}
                            className={`w-8 h-8 rounded-lg flex items-center justify-center transition-colors ${isPinned ? 'bg-indigo-500/30 text-indigo-200' : 'bg-white/10 hover:bg-white/20'}`}
                            title={isPinned ? "Desafixar menu" : "Fixar menu lateral"}
                            aria-label="Fixar ajuda"
                        >
                            {isPinned ? <PinOff className="h-4 w-4" /> : <Pin className="h-4 w-4" />}
                        </button>
                        <button
                            onClick={closeHelp}
                            className="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
                            aria-label="Fechar ajuda"
                        >
                            <X className="h-4 w-4" />
                        </button>
                    </div>
                </div>

                {/* ── Tabs Navigation ── */}
                {helpData?.tabs && helpData.tabs.length > 0 && (
                    <div className="px-5 pt-3 border-b border-slate-100 bg-slate-50 flex-shrink-0">
                        <div className="flex gap-4 overflow-x-auto no-scrollbar scroll-smooth">
                            {helpData.tabs.map((tab) => {
                                if (!tab || !tab.id) return null;
                                const active = activeTabId === tab.id;
                                return (
                                    <button
                                        key={tab.id}
                                        onClick={() => setActiveTabId(tab.id)}
                                        className={`pb-3 text-xs font-bold uppercase tracking-wider border-b-2 transition-all whitespace-nowrap ${active ? 'border-indigo-600 text-indigo-600 font-black' : 'border-transparent text-slate-400 hover:text-slate-600'}`}
                                    >
                                        {tab.label || 'Aba'}
                                    </button>
                                );
                            })}
                        </div>
                    </div>
                )}

                {/* ── Body ── */}
                <div className="flex-1 overflow-y-auto custom-scrollbar">
                    {helpData ? (
                        <div className="p-5 space-y-6">
                            {/* Category badge + description */}
                            <div className={`p-4 rounded-xl border ${categoryStyle?.bg || 'bg-gray-50'} ${categoryStyle?.border || 'border-gray-200'}`}>
                                <span className={`text-[10px] font-black uppercase tracking-widest ${categoryStyle?.text || 'text-gray-600'}`}>
                                    {helpData.category || 'Geral'}
                                </span>
                                <p className="mt-1.5 text-sm text-slate-700 font-medium leading-relaxed">
                                    {content?.description || 'Nenhum detalhe adicional disponível para este item.'}
                                </p>
                            </div>

                            {/* Steps */}
                            {content?.steps && Array.isArray(content.steps) && content.steps.length > 0 && (
                                <div className="animate-in fade-in slide-in-from-bottom-2 duration-300">
                                    <div className="flex items-center gap-2 mb-3">
                                        <List className="h-4 w-4 text-slate-400" />
                                        <h3 className="text-xs font-black uppercase tracking-widest text-slate-400">
                                            Como usar
                                        </h3>
                                    </div>
                                    <ol className="space-y-3">
                                        {content.steps.map((step, i) => (
                                            <li key={i} className="flex gap-3 items-start">
                                                <span className="flex-shrink-0 w-5 h-5 rounded-full bg-slate-900 text-white text-[10px] font-black flex items-center justify-center mt-0.5 shadow-sm">
                                                    {i + 1}
                                                </span>
                                                <p className="text-[13px] text-slate-600 font-medium leading-relaxed">{step}</p>
                                            </li>
                                        ))}
                                    </ol>
                                </div>
                            )}

                            {/* Tips */}
                            {content?.tips && Array.isArray(content.tips) && content.tips.length > 0 && (
                                <div className="bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 rounded-xl p-4 animate-in fade-in zoom-in-95 duration-500">
                                    <div className="flex items-center gap-2 mb-3">
                                        <Lightbulb className="h-4 w-4 text-amber-600" />
                                        <h3 className="text-xs font-black uppercase tracking-widest text-amber-700">
                                            Dicas Pro
                                        </h3>
                                    </div>
                                    <ul className="space-y-2.5">
                                        {content.tips.map((tip, i) => (
                                            <li key={i} className="flex gap-2.5 items-start">
                                                <div className="bg-amber-400/20 p-1 rounded-md mt-0.5 shadow-xs">
                                                    <Zap className="h-3 w-3 text-amber-600 flex-shrink-0" />
                                                </div>
                                                <p className="text-xs text-amber-900 font-semibold leading-relaxed">{tip}</p>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}

                            {/* Related links */}
                            {helpData.links && Array.isArray(helpData.links) && helpData.links.length > 0 && (
                                <div className="pb-4">
                                    <div className="flex items-center gap-2 mb-3 pt-2">
                                        <ArrowRight className="h-4 w-4 text-slate-400" />
                                        <h3 className="text-xs font-black uppercase tracking-widest text-slate-400">
                                            Módulos Relacionados
                                        </h3>
                                    </div>
                                    <div className="space-y-2">
                                        {helpData.links.map((link, idx) => (
                                            <button
                                                key={link?.path || idx}
                                                onClick={() => link?.path && handleNavigate(link.path)}
                                                className="w-full flex items-center justify-between px-4 py-3 rounded-xl border border-slate-200 bg-white hover:border-slate-900 hover:bg-slate-900 hover:text-white group transition-all duration-200 shadow-sm hover:shadow-md"
                                            >
                                                <span className="text-sm font-semibold">{link?.label || 'Link'}</span>
                                                <ChevronRight className="h-4 w-4 opacity-30 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform" />
                                            </button>
                                        ))}
                                    </div>
                                </div>
                            )}

                            {/* Footer Link to help center */}
                            <div className="border-t border-slate-100 pt-4 pb-4">
                                <button
                                    onClick={() => handleNavigate('/ajuda')}
                                    className="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl border-2 border-dashed border-slate-200 text-slate-400 hover:border-slate-900 hover:text-slate-900 hover:bg-slate-50 text-sm font-bold transition-all"
                                >
                                    <BookOpen className="h-4 w-4" />
                                    Ver Central de Ajuda Completa
                                    <ExternalLink className="h-3 w-3" />
                                </button>
                            </div>
                        </div>
                    ) : (
                        <div className="p-5 space-y-4">
                            <div className="bg-slate-50 border border-slate-200 rounded-xl p-4 text-center">
                                {loadingHelp ? (
                                    <div className="flex flex-col items-center gap-2 py-4">
                                        <div className="w-8 h-8 border-2 border-slate-300 border-t-slate-900 rounded-full animate-spin" />
                                        <p className="text-xs text-slate-400 font-bold">Carregando...</p>
                                    </div>
                                ) : (
                                    <>
                                        <HelpCircle className="h-8 w-8 text-slate-300 mx-auto mb-2" />
                                        <p className="text-sm font-bold text-slate-500">Nenhuma ajuda específica para esta tela.</p>
                                        <p className="text-xs text-slate-400 mt-1">Explore outros módulos abaixo ou acesse a Central de Ajuda.</p>
                                    </>
                                )}
                            </div>

                            <button
                                onClick={() => handleNavigate('/ajuda')}
                                className="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-slate-900 text-white text-sm font-bold hover:bg-slate-800 transition-colors shadow-md"
                            >
                                <BookOpen className="h-4 w-4" />
                                Abrir Central de Ajuda
                            </button>

                            {allModules && allModules.length > 0 && (
                                <div className="pt-2">
                                    <p className="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-3">Todos os Módulos</p>
                                    <div className="space-y-1.5 max-h-[50vh] overflow-y-auto pr-1 custom-scrollbar">
                                        {allModules.map((mod) => {
                                            if (!mod) return null;
                                            const style = getCategoryStyle(mod.category);
                                            return (
                                                <button
                                                    key={mod.route_path}
                                                    onClick={() => handleNavigate(mod.route_path)}
                                                    className="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg border border-slate-100 bg-white hover:border-slate-300 hover:bg-slate-50 transition-all text-left group"
                                                >
                                                    <span className={`text-[9px] font-black uppercase px-1.5 py-0.5 rounded ${style?.bg || 'bg-gray-100'} ${style?.text || 'text-gray-700'} flex-shrink-0`}>
                                                        {mod.category?.split('/')[0]?.trim() || 'Geral'}
                                                    </span>
                                                    <span className="text-sm font-semibold text-slate-700 group-hover:text-slate-900 truncate flex-1">
                                                        {mod.title || 'Módulo'}
                                                    </span>
                                                    <ChevronRight className="h-3 w-3 text-slate-300 group-hover:text-slate-600 flex-shrink-0" />
                                                </button>
                                            );
                                        })}
                                    </div>
                                </div>
                            )}
                        </div>
                    )}
                </div>

                {/* ── Footer ── */}
                <div className="flex-shrink-0 border-t border-slate-100 px-5 py-3 bg-slate-50">
                    <p className="text-[10px] text-slate-400 text-center font-medium">
                        MetalFisa PCP · Central de Ajuda · Pressione <kbd className="px-1 py-0.5 bg-white border border-slate-200 rounded text-[9px] font-mono shadow-sm">ESC</kbd> para fechar
                    </p>
                </div>
            </aside>
        </>
    );
}
</file>

<file path="client/src/components/ProductionAppointmentModal.jsx">
import React, { useState, useEffect, useRef } from 'react';
import { Save, Clock, X, CheckSquare, ChevronRight, CheckCircle, AlertTriangle, History, ChevronDown, ChevronUp, Play, Pause, Square, RotateCcw } from 'lucide-react';
import { useAuth } from '../contexts/AuthContext';
import { getAppointmentHistory } from '../services/api';
import { useTimer } from '../contexts/TimerContext';

export default function ProductionAppointmentModal({ op, onClose, onSave }) {
    const { user } = useAuth();
    const { timers, startTimer, pauseTimer, restartTimer, getElapsedTime } = useTimer();
    const timerId = `${op.op}_${op.item_op || '01'}_${op.sequen || '001'}_${op.operacao}`;
    const globalTimer = timers[timerId] || null;

    // Default to current time range
    const now = new Date();
    const oneHourAgo = new Date(now.getTime() - 60 * 60 * 1000);

    const planned = Number(op.qtd_planejada_op) || 0;
    const produced = Number(op.qtd_produzida_real) || 0;
    const balance = Math.max(0, planned - produced);

    const isRunning = globalTimer?.isRunning || false;
    const startedAtStr = globalTimer?.startedAt
        ? new Date(globalTimer.startedAt).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
        : null;
    const [formData, setFormData] = useState({
        data_inicio: oneHourAgo.toISOString().split('T')[0],
        hora_inicio: oneHourAgo.toTimeString().slice(0, 5),
        data_fim: now.toISOString().split('T')[0],
        hora_fim: now.toTimeString().slice(0, 5),
        quantidade: '',
        observacao: ''
    });
    const [loading, setLoading] = useState(false);
    const [history, setHistory] = useState([]);
    const [loadingHistory, setLoadingHistory] = useState(true);
    const [showHistory, setShowHistory] = useState(false);
    const qtdInputRef = useRef(null);

    // Auto-focus no campo de quantidade ao abrir o modal
    useEffect(() => {
        // Um pequeno delay garante que o modal terminou de renderizar na tela
        const timer = setTimeout(() => {
            if (qtdInputRef.current) {
                qtdInputRef.current.focus();
            }
        }, 100);
        return () => clearTimeout(timer);
    }, []);

    // No tick interval — purely event-driven

    const handleStartStopwatch = () => {
        startTimer(op);
        onClose(); // Hide Modal when timer starts
    };

    const handlePauseStopwatch = () => {
        pauseTimer(timerId);
    };

    const handleStopStopwatch = () => {
        pauseTimer(timerId);
        // Fill form dates from timer timestamps
        const startDate = globalTimer?.startedAt ? new Date(globalTimer.startedAt) : oneHourAgo;
        const endDate = new Date();
        setFormData(prev => ({
            ...prev,
            data_inicio: startDate.toISOString().split('T')[0],
            hora_inicio: startDate.toTimeString().slice(0, 5),
            data_fim: endDate.toISOString().split('T')[0],
            hora_fim: endDate.toTimeString().slice(0, 5)
        }));
    };

    const handleRestartStopwatch = () => {
        restartTimer(timerId);
        onClose();
    };

    // Load history on mount
    useEffect(() => {
        loadHistory();
    }, []);

    const loadHistory = async () => {
        setLoadingHistory(true);
        try {
            const data = await getAppointmentHistory(
                op.op, op.item_op, op.sequen, op.operacao
            );
            setHistory(data || []);
        } catch (err) {
            console.error('Erro ao carregar histórico:', err);
        } finally {
            setLoadingHistory(false);
        }
    };

    const handleSubmit = async (e) => {
        e.preventDefault();

        const qty = Number(formData.quantidade);
        if (qty > balance) {
            // Validação visual já deve impedir, mas duplo check
            return;
        }

        setLoading(true);
        try {
            const start = `${formData.data_inicio} ${formData.hora_inicio}:00`;
            const end = `${formData.data_fim} ${formData.hora_fim}:00`;

            await onSave({
                op_numero: op.op,
                op_item: op.item_op,
                op_sequencia: op.sequen,
                operacao_codigo: op.operacao,
                usuario: user?.nome || user?.login || 'Desconhecido',
                quantidade: formData.quantidade,
                data_inicio: start,
                data_fim: end,
                observacao: formData.observacao
            });
            onClose();
        } catch (error) {
            alert('Erro ao salvar: ' + error.message);
        } finally {
            setLoading(false);
        }
    };

    return (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
            <div className="bg-white rounded-xl shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto">
                <div className="flex justify-between items-center p-4 border-b">
                    <h3 className="font-bold text-lg flex items-center gap-2">
                        <CheckSquare className="w-5 h-5 text-green-600" />
                        Apontar Produção
                    </h3>
                    <button onClick={onClose} className="text-slate-400 hover:text-slate-600">
                        <X className="w-5 h-5" />
                    </button>
                </div>

                <div className="p-4 space-y-4">

                    {/* INFO BOX - Compacto */}
                    <div className="bg-slate-50 p-2 rounded text-xs border border-slate-200 flex justify-between items-center">
                        <div>
                            <p><strong>OP:</strong> {op.op} <span className="text-slate-500">({op.desc_produto})</span></p>
                            <p><strong>Proc:</strong> {op.operacao} <span className="text-slate-500">({op.desc_operacao})</span></p>
                        </div>
                        <div className="text-right">
                            <p className="text-slate-500">Usuário:</p>
                            <p className="font-bold text-slate-700">{user?.nome || user?.login}</p>
                        </div>
                    </div>

                    {/* FLOW GUIDANCE - Compacto */}
                    {op.next_desc_operacao ? (
                        <div className="bg-blue-50 border border-blue-100 px-3 py-1.5 rounded flex items-center justify-between text-xs">
                            <div className="flex items-center gap-2 text-blue-800">
                                <ChevronRight className="w-3 h-3 text-blue-600" />
                                <span className="font-semibold">Destino:</span>
                                <span>{op.next_desc_operacao}</span>
                            </div>
                        </div>
                    ) : (
                        <div className="bg-green-50 border border-green-100 px-3 py-1.5 rounded flex items-center gap-2 text-xs text-green-800">
                            <CheckCircle className="w-3 h-3" />
                            <span className="font-semibold">Processo Final</span> - Enviar p/ Estoque/Expedição
                        </div>
                    )}

                    {/* HISTORY SECTION */}
                    {loadingHistory ? (
                        <div className="bg-slate-50 border border-slate-200 p-3 rounded text-center text-sm text-slate-500">
                            <History className="w-4 h-4 inline-block mr-2 animate-pulse" />
                            Carregando histórico...
                        </div>
                    ) : history.length > 0 ? (
                        <div className="bg-slate-50 border border-slate-200 rounded overflow-hidden">
                            <button
                                onClick={() => setShowHistory(!showHistory)}
                                className="w-full px-3 py-2 flex items-center justify-between hover:bg-slate-100 transition-colors"
                            >
                                <span className="text-xs font-bold text-slate-700 flex items-center gap-2">
                                    <History className="w-4 h-4 text-slate-500" />
                                    Histórico ({history.length} apontamento{history.length !== 1 ? 's' : ''})
                                </span>
                                {showHistory ? <ChevronUp className="w-4 h-4 text-slate-400" /> : <ChevronDown className="w-4 h-4 text-slate-400" />}
                            </button>

                            {showHistory && (
                                <div className="max-h-60 overflow-y-auto border-t border-slate-200">
                                    {history.slice(0, 10).map((item, idx) => {
                                        const dataInicio = new Date(item.data_inicio);
                                        const dataFim = new Date(item.data_fim);
                                        const isToday = dataFim.toDateString() === new Date().toDateString();

                                        return (
                                            <div key={idx} className="p-3 border-b border-slate-100 last:border-b-0 hover:bg-white transition-colors">
                                                <div className="flex items-start justify-between gap-2 mb-1">
                                                    <div className="flex items-center gap-2 flex-1">
                                                        <div className="bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold text-sm">
                                                            {parseFloat(item.quantidade).toFixed(2)} pc
                                                        </div>
                                                        <span className="text-xs text-slate-600 font-medium">{item.usuario}</span>
                                                    </div>
                                                    <span className={`text-xs font-medium ${isToday ? 'text-blue-600' : 'text-slate-500'
                                                        }`}>
                                                        {isToday ? 'Hoje' : dataFim.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' })}
                                                        {' '}{dataFim.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}
                                                    </span>
                                                </div>

                                                {/* Status da Conferência */}
                                                {(item.conferencia_status || item.conferencia_obs) && (
                                                    <div className="flex flex-wrap items-center gap-2 mt-1.5 mb-1 text-[10px]">
                                                        {item.conferencia_status === 'OK' && <span className="text-green-600 font-bold border border-green-200 bg-green-50 px-1.5 py-0.5 rounded">Conf: OK</span>}
                                                        {item.conferencia_status === 'PENDENTE' && <span className="text-amber-600 font-bold border border-amber-200 bg-amber-50 px-1.5 py-0.5 rounded flex items-center gap-1"><Clock className="w-2.5 h-2.5" /> Conf: Pendente</span>}
                                                        {item.conferencia_status === 'DIVERGENTE' && <span className="text-red-600 font-bold border border-red-200 bg-red-50 px-1.5 py-0.5 rounded">Conf: Divergente</span>}

                                                        {item.conferido_por && <span className="text-slate-500 italic">por {item.conferido_por}</span>}
                                                    </div>
                                                )}

                                                {item.conferencia_obs && (
                                                    <div className="text-[10px] text-red-600 italic bg-red-50 border border-red-100 px-2 py-1 rounded mt-1">
                                                        <span className="font-bold">Nota do Conferente:</span> {item.conferencia_obs}
                                                    </div>
                                                )}
                                                {item.observacao && (
                                                    <div className="text-xs text-slate-500 italic bg-slate-50 px-2 py-1 rounded mt-1">
                                                        "{item.observacao}"
                                                    </div>
                                                )}
                                            </div>
                                        );
                                    })}
                                </div>
                            )}
                        </div>
                    ) : (
                        <div className="bg-blue-50 border border-blue-100 p-3 rounded text-sm text-blue-700 flex items-center gap-2">
                            <History className="w-4 h-4" />
                            <span>Nenhum apontamento anterior encontrado</span>
                        </div>
                    )}

                    <form onSubmit={handleSubmit} className="space-y-3">
                        {/* STOPWATCH MODULE — Static display, no live counter */}
                        <div className="bg-white border rounded-lg p-3 text-center shadow-sm">
                            <div className="text-xs font-bold text-slate-500 uppercase tracking-wide mb-1">Cronômetro de Operação</div>
                            <div className="font-mono text-2xl font-bold tracking-wider text-slate-800 mb-3">
                                {isRunning
                                    ? <span className="text-emerald-600">▶ Iniciado {startedAtStr}</span>
                                    : startedAtStr
                                        ? <span className="text-slate-600">⏸ Parado — Início: {startedAtStr}</span>
                                        : <span className="text-slate-400">Pronto para iniciar</span>
                                }
                            </div>
                            <div className="flex justify-center gap-2">
                                {!isRunning ? (
                                    <button
                                        type="button"
                                        onClick={handleStartStopwatch}
                                        className="flex items-center gap-1 bg-blue-100 hover:bg-blue-200 text-blue-700 px-4 py-1.5 rounded-md font-semibold text-sm transition-colors"
                                    >
                                        <Play className="w-4 h-4" />
                                        {globalTimer ? 'Reiniciar' : 'Iniciar'}
                                    </button>
                                ) : (
                                    <button
                                        type="button"
                                        onClick={handlePauseStopwatch}
                                        className="flex items-center gap-1 bg-amber-100 hover:bg-amber-200 text-amber-700 px-4 py-1.5 rounded-md font-semibold text-sm transition-colors"
                                    >
                                        <Pause className="w-4 h-4" />
                                        Pausar
                                    </button>
                                )}
                                <button
                                    type="button"
                                    onClick={handleStopStopwatch}
                                    disabled={!globalTimer}
                                    className="flex items-center gap-1 bg-rose-100 hover:bg-rose-200 text-rose-700 px-4 py-1.5 rounded-md font-semibold text-sm transition-colors disabled:opacity-50"
                                >
                                    <Square className="w-4 h-4" />
                                    Cessar Tempo
                                </button>
                                <button
                                    type="button"
                                    onClick={handleRestartStopwatch}
                                    disabled={!globalTimer}
                                    className="flex items-center gap-1 bg-slate-100 hover:bg-slate-200 text-slate-700 px-4 py-1.5 rounded-md font-semibold text-sm transition-colors disabled:opacity-50"
                                    title="Zerar Cronômetro"
                                >
                                    <RotateCcw className="w-4 h-4" />
                                    Zerar
                                </button>
                            </div>
                        </div>

                        <div className="bg-slate-50 p-2.5 rounded border">
                            <div className="flex justify-between items-center mb-1">
                                <label className="block text-xs font-bold text-slate-700">Qtd. Produzida neste tempo</label>
                                <span className="text-xs font-bold text-slate-500">Saldo: {balance}</span>
                            </div>
                            <input type="number" step="0.01" required
                                ref={qtdInputRef}
                                max={balance}
                                className="w-full border rounded p-2 text-lg text-slate-900 border-slate-300 focus:border-green-500 outline-none"
                                value={formData.quantidade} onChange={e => setFormData({ ...formData, quantidade: e.target.value })}
                                placeholder={`Máx: ${balance}`} autoFocus />

                            <div className="mt-1 flex justify-between text-[11px]">
                                <span className="text-slate-400">Pedido: {planned} | Já Prod: {produced}</span>
                                {Number(formData.quantidade) > balance && (
                                    <span className="text-red-600 font-bold flex items-center gap-1">
                                        <AlertTriangle className="w-3 h-3" />
                                        Excede saldo!
                                    </span>
                                )}
                            </div>
                        </div>

                        <div className="grid grid-cols-2 gap-3">
                            <div className="flex items-center gap-2 border rounded p-1.5 focus-within:border-green-500">
                                <div className="flex flex-col flex-1 pl-1">
                                    <label className="text-[10px] font-bold text-slate-500 uppercase">Início</label>
                                    <div className="flex gap-1">
                                        <input type="date" required className="w-[100px] text-xs outline-none bg-transparent"
                                            value={formData.data_inicio} onChange={e => setFormData({ ...formData, data_inicio: e.target.value })} />
                                        <input type="time" required className="flex-1 text-xs outline-none bg-transparent"
                                            value={formData.hora_inicio} onChange={e => setFormData({ ...formData, hora_inicio: e.target.value })} />
                                    </div>
                                </div>
                            </div>

                            <div className="flex items-center gap-2 border rounded p-1.5 focus-within:border-green-500">
                                <div className="flex flex-col flex-1 pl-1">
                                    <label className="text-[10px] font-bold text-slate-500 uppercase">Fim</label>
                                    <div className="flex gap-1">
                                        <input type="date" required className="w-[100px] text-xs outline-none bg-transparent"
                                            value={formData.data_fim} onChange={e => setFormData({ ...formData, data_fim: e.target.value })} />
                                        <input type="time" required className="flex-1 text-xs outline-none bg-transparent"
                                            value={formData.hora_fim} onChange={e => setFormData({ ...formData, hora_fim: e.target.value })} />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label className="block text-xs font-bold text-slate-700 mb-1">Observação</label>
                            <textarea className="w-full border rounded p-2 text-sm" rows="2"
                                value={formData.observacao} onChange={e => setFormData({ ...formData, observacao: e.target.value })}></textarea>
                        </div>

                        <button
                            type="submit"
                            disabled={loading || Number(formData.quantidade) > balance || Number(formData.quantidade) <= 0}
                            className="w-full bg-green-600 text-white rounded-lg p-2 font-bold hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed flex justify-center items-center gap-2 shadow-sm"
                        >
                            <Save className="w-4 h-4" />
                            {loading ? 'Salvando...' : 'Confirmar Apontamento'}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    );
}

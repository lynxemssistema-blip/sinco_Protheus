            const permsArray = Object.entries(permMatrix)
                .filter(([_, p]) => p.can_view || p.can_create || p.can_edit || p.can_delete)
                .map(([page_id, p]) => ({ page_id, ...p }));

            if (typeof permSelectedUser === 'string' && permSelectedUser.startsWith('PROFILE_')) {

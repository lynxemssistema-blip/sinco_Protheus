                const peso_kg = item.peso_kg === '' || item.peso_kg == null ? null : parseFloat(item.peso_kg);
                const area_pintura_m2 = item.area_pintura_m2 === '' || item.area_pintura_m2 == null ? null : parseFloat(item.area_pintura_m2);


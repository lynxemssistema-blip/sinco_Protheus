                                                        <div className="text-[10px] text-slate-500 font-mono">
                                                            {item.op}-{item.item_op}
                                                            {item.sequencia && item.sequencia !== '001' && (
                                                                <span className="ml-1 text-slate-400">Seq: {item.sequencia}</span>
                                                            )}

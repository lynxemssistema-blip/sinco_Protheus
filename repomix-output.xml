                                    onChange={e => setEditSchema(p => ({ ...p, descricao: e.target.value }))}
                                />
                            </div>

                            <div>
                                <label className="block text-[10px] font-bold text-slate-400 uppercase mb-1">Colunas-Chave (opcional)</label>

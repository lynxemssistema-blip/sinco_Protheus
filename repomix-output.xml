                                    ? opData.conjuntos.map(c => <ArvoreNode key={c.id} item={c} />)
                                    : <p className="text-sm text-slate-500 text-center py-8">Nenhum conjunto encontrado.</p>
                                }
                            </div>
                        )}

                        {/* ABA: Por Máquina */}
                        {activeTab === 'queue' && (
                            <FilasMaquina conjuntos={opData.conjuntos || []} />
                        )}
                    </>
                )}

            </div>
        </div>
    );
}

    def handle_open_file(self, data):
        """Abre um arquivo no Solid Edge pelo caminho completo (UNC ou local)"""
        try:
            file_path = data.get('caminho', '').strip()
            if not file_path:
                self.send_json({'error': 'Campo "caminho" obrigatório'}, 400)
                return
            if not os.path.exists(file_path):
                self.send_json({'error': f'Arquivo não encontrado: {file_path}'}, 404)
                return
            app = self.get_solidedge()
            app.Documents.Open(file_path)
            self.send_json({'ok': True, 'caminho': file_path})
        except Exception as ex:
            self.send_json({'error': str(ex), 'traceback': traceback.format_exc()}, 500)

    def handle_export_dxf(self, data):
        """Export DXF endpoint"""
        try:
            app = self.get_solidedge()
            
            if not app.ActiveDocument:
                self.send_json({'success': False, 'error': 'Nenhum documento aberto'}, 404)
                return
            
            doc = app.ActiveDocument
            
            if not hasattr(doc, 'Sheets'):
                self.send_json({'success': False, 'error': 'Nao e um Draft'}, 400)
                return
            
            output_path = data.get('outputPath')
            if not output_path:
                base_name = os.path.splitext(doc.FullName)[0]
                output_path = f"{base_name}.dxf"
            
            doc.SaveAs(output_path)
            self.send_json({'success': True, 'filePath': output_path})
        except Exception as e:
            self.send_json({'success': False, 'error': str(e)}, 500)
    
    def handle_export_pdf(self, data):
        """Export PDF endpoint"""
        try:
            app = self.get_solidedge()
            
            if not app.ActiveDocument:
                self.send_json({'success': False, 'error': 'Nenhum documento aberto'}, 404)
                return
            
            doc = app.ActiveDocument
            
            output_path = data.get('outputPath')
            if not output_path:
                base_name = os.path.splitext(doc.FullName)[0]
                output_path = f"{base_name}.pdf"
            
            if hasattr(doc, 'SaveAsPDF'):
                doc.SaveAsPDF(output_path)
            else:
                doc.PrintOut(1, output_path, True)
            
            self.send_json({'success': True, 'filePath': output_path})
        except Exception as e:
            self.send_json({'success': False, 'error': str(e)}, 500)


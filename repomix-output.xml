def update_function(text, fn_name):
    # const handlePrint... = async (pedido, e, itemId = null) => {
    search_def = f"const {fn_name} = async (pedido, e, itemId = null) => {{"
    repl_def = f"const {fn_name} = async (pedido, e, itemId = null, itemObj = null) => {{"
    

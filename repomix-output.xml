                                                        <span className="text-sm font-bold truncate">{link.label}</span>
                                                        <ChevronRight className="h-4 w-4 ml-auto opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-transform flex-shrink-0" />

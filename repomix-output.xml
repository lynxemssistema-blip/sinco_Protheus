                                        const parts = group.info.proxima_entrega.split('/');
                                        if (parts.length === 3) {
                                            const year = parts[2].length === 2 ? `20${parts[2]}` : parts[2];
                                            deliveryDateDisplay = `${parts[0]}/${parts[1]}/${year}`;
                                        } else {
                                            deliveryDateDisplay = group.info.proxima_entrega;

            'ABERTA': 'Aberta',
            'EM_APROVACAO': 'Em Aprovação',
            'EM_COTACAO': 'Em Cotação',
            'GEROU_PEDIDO': 'Com Pedido'
        };
        return (
            <span className={`px-2 py-0.5 text-xs font-medium rounded border ${styles[status] || styles.ABERTA}`}>
                {labels[status] || status}
            </span>
        );
    };

    return (

import React, { useState, useEffect } from 'react';
import { Search, TreeDeciduous, List, AlertTriangle, CheckCircle, Clock } from 'lucide-react';
import api from '../../services/api';

const MaterialExplosionTab = ({ filters }) => {
    const [viewMode, setViewMode] = useState('tree'); // 'tree' | 'flat'
    const [data, setData] = useState(null);
    const [loading, setLoading] = useState(false);
    const [error, setError] = useState(null);

    const [selectedProduct, setSelectedProduct] = useState(null);

    useEffect(() => {
        if (filters.pedido) {
            fetchExplosion();
        }
    }, [filters, selectedProduct]);

    const fetchExplosion = async () => {
        setLoading(true);
        setError(null);
        try {
            // Se tivermos um produto selecionado via UI interna, usamos ele.
            // Caso contrário, usamos o do filtro (que pode vir vazio, acionando a busca de lista)
            const produtoParaBusca = selectedProduct?.produto || filters.produto;
            const qtdParaBusca = selectedProduct?.qtd || filters.quantidade || 1;

            const response = await api.post('/materials/explosion', {
                pedido: filters.pedido,
                produto_codigo: produtoParaBusca,
                quantidade_pedido: qtdParaBusca
            });

            if (response.data.multiplo_items) {
                setData({ ...response.data, isSelection: true });
            } else {
                setData(response.data);
            }
        } catch (err) {
            console.error('Erro ao buscar explosão:', err);
            setError('Falha ao carregar estrutura de materiais. Verifique os dados do pedido.');
        } finally {
            setLoading(false);
        }
    };

    const handleSelectItem = (item) => {
        setSelectedProduct(item);
        // O useEffect vai disparar o fetch novamente
    };

    if (!filters.pedido) {
        return (
            <div className="flex flex-col items-center justify-center p-12 text-gray-400 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                <Search className="h-12 w-12 mb-4 opacity-50" />
                <p className="text-lg">Selecione um Pedido para visualizar a estrutura.</p>
            </div>
        );
    }

    if (loading) {
        return (
            <div className="flex items-center justify-center p-12">
                <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                <span className="ml-3 text-gray-500">Buscando informações...</span>
            </div>
        );
    }

    if (error) {
        return (
            <div className="p-4 bg-red-50 text-red-700 rounded-lg flex items-center">
                <AlertTriangle className="h-5 w-5 mr-2" />
                {error}
            </div>
        );
    }

    if (!data) return null;

    // View: Seleção de Item (quando retorna multiplos items e nenhum foi selecionado ainda)
    if (data.isSelection && !selectedProduct) {
        return (
            <div className="space-y-6">
                <h3 className="text-lg font-semibold text-gray-800">Selecione um Produto do Pedido {filters.pedido}:</h3>
                <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <table className="w-full text-sm text-left">
                        <thead className="bg-gray-50 text-gray-500 font-medium border-b border-gray-100">
                            <tr>
                                <th className="px-6 py-3">Item</th>
                                <th className="px-6 py-3">Produto</th>
                                <th className="px-6 py-3">Descrição</th>
                                <th className="px-6 py-3 text-right">Qtd</th>
                                <th className="px-6 py-3 text-center">Ação</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100">
                            {data.items.map((item, idx) => (
                                <tr key={idx} className="hover:bg-gray-50">
                                    <td className="px-6 py-3 text-gray-500">{item.item}</td>
                                    <td className="px-6 py-3 font-medium text-gray-700">{item.produto}</td>
                                    <td className="px-6 py-3 text-gray-600">{item.descricao}</td>
                                    <td className="px-6 py-3 text-right">{item.qtd}</td>
                                    <td className="px-6 py-3 text-center">
                                        <button
                                            onClick={() => handleSelectItem(item)}
                                            className="px-3 py-1.5 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 font-medium text-xs transition-colors"
                                        >
                                            Ver Estrutura
                                        </button>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        );
    }

    // View: Explosão de Materiais (normal)
    return (
        <div className="space-y-6">
            {/* Header / Controls */}
            <div className="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                <div className="flex items-center space-x-4">
                    {selectedProduct && (
                        <button
                            onClick={() => setSelectedProduct(null)}
                            className="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-sm mr-2 flex items-center"
                        >
                            ← Voltar para Lista
                        </button>
                    )}
                    <h3 className="font-semibold text-gray-800">Visualização: {selectedProduct ? `${selectedProduct.produto} - ${selectedProduct.descricao}` : filters.produto}</h3>
                    <div className="flex bg-gray-100 p-1 rounded-lg">
                        <button
                            onClick={() => setViewMode('tree')}
                            className={`flex items-center px-3 py-1.5 rounded-md text-sm font-medium transition-all ${viewMode === 'tree' ? 'bg-white shadow text-blue-600' : 'text-gray-500 hover:text-gray-700'
                                }`}
                        >
                            <TreeDeciduous className="h-4 w-4 mr-2" />
                            Por Operação
                        </button>
                        <button
                            onClick={() => setViewMode('flat')}
                            className={`flex items-center px-3 py-1.5 rounded-md text-sm font-medium transition-all ${viewMode === 'flat' ? 'bg-white shadow text-blue-600' : 'text-gray-500 hover:text-gray-700'
                                }`}
                        >
                            <List className="h-4 w-4 mr-2" />
                            Lista Plana
                        </button>
                    </div>
                </div>

                <div className="flex items-center space-x-6 text-sm">
                    <div className="flex items-center">
                        <span className="w-3 h-3 bg-red-500 rounded-full mr-2"></span>
                        <span className="text-gray-600">Em Falta</span>
                    </div>
                    <div className="flex items-center">
                        <span className="w-3 h-3 bg-yellow-500 rounded-full mr-2"></span>
                        <span className="text-gray-600">Solicitado</span>
                    </div>
                    <div className="flex items-center">
                        <span className="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
                        <span className="text-gray-600">Disponível</span>
                    </div>
                </div>
            </div>

            {/* Content */}
            {viewMode === 'tree' ? (
                <div className="space-y-6">
                    {data.por_operacao?.map((op) => (
                        <div key={op.operacao} className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                            <div className="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                                <div>
                                    <h4 className="font-bold text-gray-800 flex items-center">
                                        <span className="bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-xs mr-2">{op.operacao}</span>
                                        {op.descricao}
                                    </h4>
                                    <div className="text-xs text-gray-500 mt-1 flex gap-4">
                                        <span>Itens: {op.resumo.total_itens}</span>
                                        {op.resumo.materiais_em_falta > 0 && (
                                            <span className="text-red-600 font-medium">⚠️ {op.resumo.materiais_em_falta} itens em falta</span>
                                        )}
                                    </div>
                                </div>
                                <button className="px-3 py-1.5 text-xs font-medium bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transition-colors">
                                    Solicitar Materiais desta OP
                                </button>
                            </div>

                            <table className="w-full text-sm text-left">
                                <thead className="bg-gray-50 text-gray-500 font-medium border-b border-gray-100">
                                    <tr>
                                        <th className="px-6 py-3">Código</th>
                                        <th className="px-6 py-3">Descrição</th>
                                        <th className="px-6 py-3 text-right">Necessário</th>
                                        <th className="px-6 py-3 text-right">Disponível</th>
                                        <th className="px-6 py-3 text-center">Status</th>
                                        <th className="px-6 py-3 text-right">Compra</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-gray-100">
                                    {op.materiais.map((mat, idx) => (
                                        <tr key={`${op.operacao}-${mat.codigo}-${idx}`} className="hover:bg-gray-50">
                                            <td className="px-6 py-3 font-medium text-gray-700">{mat.codigo}</td>
                                            <td className="px-6 py-3 text-gray-600">{mat.descricao}</td>
                                            <td className="px-6 py-3 text-right font-medium">{Number(mat.qtd_total).toFixed(2)} {mat.unidade}</td>
                                            <td className={`px-6 py-3 text-right ${mat.saldo_disponivel < mat.qtd_total ? 'text-red-600 font-bold' : 'text-green-600'}`}>
                                                {Number(mat.saldo_disponivel).toFixed(2)}
                                            </td>
                                            <td className="px-6 py-3 text-center">
                                                {mat.necessidade_liquida <= 0 ? (
                                                    <span className="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                                                        <CheckCircle className="w-3 h-3 mr-1" /> OK
                                                    </span>
                                                ) : (
                                                    <span className="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-700">
                                                        Falta {Number(mat.necessidade_liquida).toFixed(2)}
                                                    </span>
                                                )}
                                            </td>
                                            <td className="px-6 py-3 text-right text-xs">
                                                {mat.compra ? (
                                                    <div className="flex flex-col items-end">
                                                        <span className="font-medium text-gray-700">{mat.status_compra}</span>
                                                        <span className="text-gray-500">{mat.compra.data_entrega || 'S/ Data'}</span>
                                                    </div>
                                                ) : (
                                                    <span className="text-gray-400">-</span>
                                                )}
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                    ))}
                </div>
            ) : (
                <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <table className="w-full text-sm text-left">
                        <thead className="bg-gray-50 text-gray-500 font-medium border-b border-gray-100">
                            <tr>
                                <th className="px-6 py-3">Nível</th>
                                <th className="px-6 py-3">Código</th>
                                <th className="px-6 py-3">Descrição</th>
                                <th className="px-6 py-3">Operação</th>
                                <th className="px-6 py-3 text-right">Qtd Total</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100">
                            {data.lista_plana?.map((item, idx) => (
                                <tr key={idx} className="hover:bg-gray-50">
                                    <td className="px-6 py-3 text-gray-500 pl-8" style={{ paddingLeft: `${item.nivel * 20 + 24}px` }}>
                                        {item.nivel}
                                    </td>
                                    <td className="px-6 py-3 font-medium text-gray-700">{item.componente}</td>
                                    <td className="px-6 py-3 text-gray-600">{item.descricao}</td>
                                    <td className="px-6 py-3">
                                        <span className="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-xs">
                                            {item.operacao || 'N/A'}
                                        </span>
                                    </td>
                                    <td className="px-6 py-3 text-right font-medium">{Number(item.qtd_total).toFixed(4)}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
        </div>
    );
};

export default MaterialExplosionTab;
</file>

<file path="client/src/components/materials/SolicitacoesTab.jsx">
import React, { useState, useEffect } from 'react';
import { Plus, Filter, Package, User, Calendar, CheckCircle, Clock, Truck } from 'lucide-react';
import api from '../../services/api';

const SolicitacoesTab = () => {
    const [solicitacoes, setSolicitacoes] = useState([]);
    const [loading, setLoading] = useState(true);
    const [statusFilter, setStatusFilter] = useState('');

    useEffect(() => {
        fetchSolicitacoes();
    }, [statusFilter]);

    const fetchSolicitacoes = async () => {
        setLoading(true);
        try {
            const params = statusFilter ? { status: statusFilter } : {};
            const response = await api.get('/almoxarifado/solicitacoes', { params });
            setSolicitacoes(response.data);
        } catch (err) {
            console.error(err);
        } finally {
            setLoading(false);
        }
    };

    const handleEntregar = async (id) => {
        if (!confirm('Confirmar entrega desta solicitação?')) return;
        try {
            await api.put(`/almoxarifado/solicitacoes/${id}/entregar`, { usuario: 'Mário PCP' }); // User hardcoded for now
            fetchSolicitacoes();
        } catch (err) {
            alert('Erro ao entregar solicitação');
        }
    };

    const getStatusInfo = (status) => {
        switch (status) {
            case 'PENDENTE': return { color: 'bg-yellow-100 text-yellow-700', icon: Clock };
            case 'SEPARADO': return { color: 'bg-blue-100 text-blue-700', icon: Package };
            case 'ENTREGUE': return { color: 'bg-green-100 text-green-700', icon: CheckCircle };
            default: return { color: 'bg-gray-100 text-gray-700', icon: Filter };
        }
    };

    return (
        <div className="space-y-6">
            <div className="flex justify-between items-center">
                <div className="flex gap-2">
                    {['', 'PENDENTE', 'SEPARADO', 'ENTREGUE'].map(status => (
                        <button
                            key={status}
                            onClick={() => setStatusFilter(status)}
                            className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${statusFilter === status
                                    ? 'bg-blue-600 text-white shadow-sm'
                                    : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50'
                                }`}
                        >
                            {status || 'Todas'}
                        </button>
                    ))}
                </div>
                <button className="flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                    <Plus className="h-4 w-4 mr-2" />
                    Nova Solicitação Avulsa
                </button>
            </div>

            {loading ? (
                <div className="text-center py-12 text-gray-400">Carregando solicitações...</div>
            ) : (
                <div className="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <table className="w-full text-sm text-left">
                        <thead className="bg-gray-50 text-gray-500 font-medium border-b border-gray-100">
                            <tr>
                                <th className="px-6 py-4">Número</th>
                                <th className="px-6 py-4">Data</th>
                                <th className="px-6 py-4">Origem (OP/Operação)</th>
                                <th className="px-6 py-4">Solicitante</th>
                                <th className="px-6 py-4">Status</th>
                                <th className="px-6 py-4 text-right">Ações</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-100">
                            {solicitacoes.map((sol) => {
                                const StatusIcon = getStatusInfo(sol.status).icon;
                                return (
                                    <tr key={sol.id} className="hover:bg-gray-50 transition-colors">
                                        <td className="px-6 py-4 font-mono font-medium text-gray-700">{sol.numero}</td>
                                        <td className="px-6 py-4 text-gray-600">
                                            {new Date(sol.data_solicitacao).toLocaleDateString()}
                                        </td>
                                        <td className="px-6 py-4">
                                            <div className="flex flex-col">
                                                <span className="font-medium text-gray-800">OP {sol.op}</span>
                                                <span className="text-xs text-gray-500">
                                                    {sol.operacao} - {sol.operacao_descricao}
                                                </span>
                                            </div>
                                        </td>
                                        <td className="px-6 py-4">
                                            <div className="flex items-center text-gray-600">
                                                <User className="h-3 w-3 mr-1.5" />
                                                {sol.solicitante}
                                            </div>
                                        </td>
                                        <td className="px-6 py-4">
                                            <span className={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium ${getStatusInfo(sol.status).color}`}>
                                                <StatusIcon className="w-3 h-3 mr-1.5" />
                                                {sol.status}
                                            </span>
                                        </td>
                                        <td className="px-6 py-4 text-right">
                                            {sol.status !== 'ENTREGUE' && (
                                                <button
                                                    onClick={() => handleEntregar(sol.id)}
                                                    className="text-blue-600 hover:text-blue-800 font-medium text-xs border border-blue-200 rounded px-2 py-1 bg-blue-50"
                                                >
                                                    Marcar Entregue
                                                </button>
                                            )}
                                        </td>
                                    </tr>
                                );
                            })}
                        </tbody>
                    </table>
                    {solicitacoes.length === 0 && (
                        <div className="flex flex-col items-center justify-center py-12 text-gray-400">
                            <Package className="h-10 w-10 mb-2 opacity-50" />
                            <p>Nenhuma solicitação encontrada.</p>
                        </div>
                    )}
                </div>
            )}
        </div>
    );
};

export default SolicitacoesTab;
</file>

<file path="client/src/components/NotesDrawer.jsx">
import React, { useState, useEffect, useRef } from 'react';
import { X, Send, CheckCircle, User, MessageSquare, Edit2, Trash2, Check, XCircle, Pin, PinOff } from 'lucide-react';
import { getSalesNotes, createSalesNote, resolveSalesNote, updateSalesNote, deleteSalesNote } from '../services/api';

export default function NotesDrawer({ isOpen, onClose, target, currentUser = 'Sistema' }) {
    const [notes, setNotes] = useState([]);
    const [newItem, setNewItem] = useState('');
    const [loading, setLoading] = useState(false);
    const [editingNote, setEditingNote] = useState(null); // { id, text }
    const [isPinned, setIsPinned] = useState(false);
    const scrollRef = useRef(null);

    useEffect(() => {
        if (isOpen && target) {
            fetchNotes();
        }
    }, [isOpen, target]);

    useEffect(() => {
        if (scrollRef.current) {
            scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
        }
    }, [notes]);

    // Handle Layout Shift when Pinned
    useEffect(() => {
        const root = document.getElementById('root');
        if (root) {
            root.style.transition = 'margin-right 0.3s ease-in-out';
            if (isPinned) {
                root.style.marginRight = '448px'; // max-w-md
            } else {
                root.style.marginRight = '0';
            }
        }

        return () => {
            if (root) root.style.marginRight = '0';
        };
    }, [isPinned]);

    const fetchNotes = async () => {
        setLoading(true);
        try {
            const res = await getSalesNotes(target.order);
            setNotes(res);
        } catch (err) {
            console.error(err);
        } finally {
            setLoading(false);
        }
    };

    const handleSend = async (e) => {
        e.preventDefault();
        if (!newItem.trim()) return;

        try {
            await createSalesNote({
                order_number: target.order,
                item_number: target.item,
                product_code: target.product,
                note_text: newItem,
                category: 'Geral',
                created_by: currentUser
            });
            setNewItem('');
            fetchNotes();
        } catch (err) {
            alert('Erro ao salvar nota');
        }
    };

    const handleResolve = async (id) => {
        try {
            await resolveSalesNote(id, currentUser);
            fetchNotes();
        } catch (err) {
            alert('Erro ao resolver nota');
        }
    };

    const handleUpdate = async (id) => {
        if (!editingNote || !editingNote.text.trim()) return;
        try {
            await updateSalesNote(id, { note_text: editingNote.text });
            setEditingNote(null);
            fetchNotes();
        } catch (err) { alert('Erro ao atualizar nota'); }
    };

    const handleDelete = async (id) => {
        if (!confirm('Tem certeza que deseja excluir esta anotação?')) return;
        try {
            await deleteSalesNote(id);
            fetchNotes();
        } catch (err) { alert('Erro ao excluir nota'); }
    };

    const groupedNotes = (notesList) => {
        const groups = {};
        notesList.forEach(note => {
            const key = note.item_number || 'GERAL';
            if (!groups[key]) groups[key] = [];
            groups[key].push(note);
        });
        return groups;
    };

    if (!isOpen) return null;

    return (
        <div className={`fixed inset-0 z-50 flex justify-end transition-all ${isPinned ? 'pointer-events-none' : ''}`}>
            {/* Backdrop - Only visible if not pinned */}
            <div
                className={`absolute inset-0 bg-black/20 backdrop-blur-sm transition-opacity duration-300 ${isPinned ? 'opacity-0' : 'opacity-100'}`}
                onClick={!isPinned ? onClose : undefined}
            />

            <div className={`relative w-full max-w-md bg-white shadow-2xl h-full flex flex-col animate-slideInRight ${isPinned ? 'pointer-events-auto border-l border-gray-200' : ''}`}>
                {/* Header */}
                <div className="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
                    <div>
                        <h3 className="font-bold text-gray-800 flex items-center gap-2">
                            <MessageSquare className="w-5 h-5 text-blue-600" />
                            Ata Viva / Notas
                        </h3>
                        <p className="text-xs text-gray-500 mt-1">
                            {target?.item
                                ? `Item ${target.item} - ${target.product}`
                                : `Pedido Geral ${target?.order}`}
                        </p>
                    </div>
                    <div className="flex items-center gap-1">
                        <button
                            onClick={() => setIsPinned(!isPinned)}
                            className={`p-2 rounded-full transition-colors ${isPinned ? 'bg-blue-100 text-blue-600' : 'hover:bg-gray-100 text-gray-400'}`}
                            title={isPinned ? "Desafixar janela" : "Fixar janela (permite usar o fundo)"}
                        >
                            {isPinned ? <Pin className="w-4 h-4" /> : <PinOff className="w-4 h-4" />}
                        </button>
                        <button onClick={onClose} className="p-2 hover:bg-gray-200 rounded-full transition-colors">
                            <X className="w-5 h-5 text-gray-500" />
                        </button>
                    </div>
                </div>

                {/* Notes List */}
                <div className="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50" ref={scrollRef}>
                    {loading && <div className="text-center text-gray-400 py-4">Carregando...</div>}

                    {Object.keys(groupedNotes(notes)).length === 0 && !loading && (
                        <div className="text-center py-8">
                            <div className="bg-gray-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
                                <MessageSquare className="w-8 h-8 text-gray-400" />
                            </div>
                            <p className="text-gray-500 text-sm">Nenhuma anotação neste pedido.</p>
                            <p className="text-gray-400 text-xs">As anotações criadas aqui aparecerão na Ata.</p>
                        </div>
                    )}

                    {Object.entries(groupedNotes(notes)).sort().map(([key, groupNotes]) => (
                        <div key={key} className="mb-4">
                            <div className={`text-xs font-bold uppercase tracking-wider mb-2 px-2 py-1 rounded w-fit ${key === 'GERAL' ? 'bg-gray-100 text-gray-600' : 'bg-blue-50 text-blue-600'}`}>
                                {key === 'GERAL' ? 'Geral / Pedido' : `Item ${key}`}
                            </div>

                            <div className="space-y-3 pl-2 border-l-2 border-gray-100">
                                {groupNotes.map(note => (
                                    <div key={note.id} className={`bg-white p-3 rounded-lg shadow-sm border border-gray-100 ${note.is_resolved ? 'opacity-75 bg-gray-50' : ''}`}>
                                        <div className="flex justify-between items-start mb-2">
                                            {/* User Info */}
                                            <div className="flex items-center gap-2">
                                                <span className="text-xs font-bold text-gray-700 flex items-center gap-1">
                                                    <User className="w-3 h-3" /> {note.created_by}
                                                </span>
                                                <span className="text-[10px] text-gray-400">
                                                    {new Date(note.created_at).toLocaleString()}
                                                </span>
                                            </div>

                                            {/* Action Buttons */}
                                            <div className="flex items-center gap-2">
                                                {!note.is_resolved ? (
                                                    <>
                                                        {editingNote?.id === note.id ? (
                                                            <div className="flex items-center gap-1">
                                                                <button onClick={() => handleUpdate(note.id)} className="text-green-600 hover:bg-green-50 p-1 rounded"><Check className="w-4 h-4" /></button>
                                                                <button onClick={() => setEditingNote(null)} className="text-red-500 hover:bg-red-50 p-1 rounded"><XCircle className="w-4 h-4" /></button>
                                                            </div>
                                                        ) : (
                                                            <>
                                                                <button onClick={() => setEditingNote({ id: note.id, text: note.note_text })} className="text-gray-400 hover:text-blue-500 p-1 rounded transition-colors" title="Editar">
                                                                    <Edit2 className="w-3 h-3" />
                                                                </button>
                                                                <button onClick={() => handleDelete(note.id)} className="text-gray-400 hover:text-red-500 p-1 rounded transition-colors" title="Excluir">
                                                                    <Trash2 className="w-3 h-3" />
                                                                </button>
                                                                <button
                                                                    onClick={() => handleResolve(note.id)}
                                                                    className="text-xs text-green-600 hover:bg-green-50 px-2 py-1 rounded border border-green-100 hover:border-green-300 transition-colors ml-1"
                                                                >
                                                                    Resolver
                                                                </button>
                                                            </>
                                                        )}
                                                    </>
                                                ) : (
                                                    <div className="flex items-center gap-2">
                                                        <span className="text-xs text-green-600 font-bold flex items-center gap-1">
                                                            <CheckCircle className="w-3 h-3" /> Resolvido
                                                        </span>
                                                        <button onClick={() => handleDelete(note.id)} className="text-gray-300 hover:text-red-300 p-1 rounded transition-colors" title="Excluir">
                                                            <Trash2 className="w-3 h-3" />
                                                        </button>
                                                    </div>
                                                )}
                                            </div>
                                        </div>

                                        {/* Note Content */}
                                        {editingNote?.id === note.id ? (
                                            <textarea
                                                className="w-full text-sm p-2 border rounded focus:ring-1 focus:ring-blue-300 outline-none"
                                                rows="3"
                                                value={editingNote.text}
                                                onChange={e => setEditingNote(prev => ({ ...prev, text: e.target.value }))}
                                                autoFocus
                                            />
                                        ) : (
                                            <p className="text-sm text-gray-700 whitespace-pre-wrap">{note.note_text}</p>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>

                {/* Footer Input */}
                <form onSubmit={handleSend} className="p-4 border-t bg-white">
                    <div className="relative">
                        <textarea
                            className="w-full border border-gray-300 rounded-lg pl-3 pr-12 py-2 text-sm focus:ring-2 focus:ring-blue-100 focus:border-blue-400 outline-none resize-none"
                            rows="3"
                            placeholder="Escreva uma observação..."
                            value={newItem}
                            onChange={e => setNewItem(e.target.value)}
                            onKeyDown={e => {
                                if (e.key === 'Enter' && !e.shiftKey) {
                                    e.preventDefault();
                                    handleSend(e);
                                }
                            }}
                        ></textarea>
                        <button
                            type="submit"
                            disabled={!newItem.trim()}
                            className="absolute bottom-3 right-3 p-1.5 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                        >
                            <Send className="w-4 h-4" />
                        </button>
                    </div>
                    <p className="text-[10px] text-gray-400 mt-1 pl-1">Pressione Enter para enviar</p>
                </form>
            </div>
        </div>
    );
}

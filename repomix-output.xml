import React, { useState, useEffect } from 'react';
import { Search, Printer, ClipboardList, Filter, Calendar } from 'lucide-react';
import { getInternalRequests } from '../services/api';

export default function InternalRequestsPage() {
    const [loading, setLoading] = useState(false);
    const [data, setData] = useState([]);
    const [filters, setFilters] = useState({
        filial: '',
        documento: '',
        codigo: '',
        dataInicial: '',
        dataFinal: ''
    });

    const formatDate = (dateStr) => {
        if (!dateStr || dateStr.length !== 8) return dateStr;
        const year = dateStr.substring(0, 4);
        const month = dateStr.substring(4, 6);
        const day = dateStr.substring(6, 8);
        return `${day}/${month}/${year}`;
    };

    const loadData = async () => {
        setLoading(true);
        try {
            const result = await getInternalRequests(filters);
            setData(result);
        } catch (error) {
            console.error(error);
            alert('Erro ao buscar requisições.');
        } finally {
            setLoading(false);
        }
    };

    const handlePrint = () => {
        window.print();
    };

    return (
        <div className="p-4 md:p-6 max-w-[1600px] mx-auto">
            {/* Header / Filters - Hidden on Print */}
            <div className="print:hidden mb-6 space-y-4">
                <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <h2 className="text-2xl font-bold text-gray-900 flex items-center gap-3">

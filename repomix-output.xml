    };

    const startEditItem = (item) => {
        setEditingItem({ ...item }); // Clone
    };

    const saveEditItem = async () => {
        setLoading(true);
        try {
            await updateRomaneioItem(currRomaneioId, editingItem.id, {
                quantidade: editingItem.quantidade,
                comentario: editingItem.comentario,

                'bg-slate-100 text-slate-600'}`}>
        {status}
    </span>
);

function formatDate(str) {
    if (!str) return '-';
    // If ISO or Date obj
    try {
        if (str.length === 8) { // YYYYMMDD
            return `${str.substr(6, 2)}/${str.substr(4, 2)}/${str.substr(0, 4)}`;
        }
        return new Date(str).toLocaleDateString();
    } catch (e) { return str; }
}

<file path="client/src/pages/PurchaseRequests.jsx">
import React, { useState } from 'react';
import { Search, Loader2, Package, FileText, Calendar, Filter, X, ShoppingCart } from 'lucide-react';
import { getPurchaseRequests } from '../services/api';

export default function PurchaseRequests() {
    const [loading, setLoading] = useState(false);
    const [results, setResults] = useState([]);
    const [hasSearched, setHasSearched] = useState(false);
    const [filters, setFilters] = useState({
        filial: '',
        numero_sc: '',
        produto: '',
        descricao: '',
        status: '',
        numero_pedido: '',
        data_de: '',
        data_ate: '',
        limit: 500
    });

    const handleSearch = async (e) => {
        e?.preventDefault();
        setLoading(true);
        setHasSearched(true);
        setResults([]);

        try {
            const params = {};
            Object.entries(filters).forEach(([key, value]) => {
                if (value) params[key] = value;
            });
            const data = await getPurchaseRequests(params);
            setResults(data);
        } catch (err) {
            console.error('Erro ao buscar solicitações:', err);
        } finally {
            setLoading(false);
        }
    };

    const handleFilterChange = (field, value) => {
        setFilters(prev => ({ ...prev, [field]: value }));
    };

    const clearFilters = () => {
        setFilters({
            filial: '',
            numero_sc: '',
            produto: '',
            descricao: '',
            status: '',
            numero_pedido: '',
            data_de: '',
            data_ate: '',
            limit: 500
        });
    };

    const formatDate = (dateStr) => {
        if (!dateStr) return '-';
        const d = new Date(dateStr);
        return d.toLocaleDateString('pt-BR');
    };

    const getStatusBadge = (status) => {
        const styles = {
            'ABERTA': 'bg-gray-100 text-gray-700 border-gray-200',
            'EM_APROVACAO': 'bg-yellow-50 text-yellow-700 border-yellow-200',

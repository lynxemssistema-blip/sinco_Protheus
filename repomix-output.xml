                                    </div>
                                </div>
                            ))}
                        </div>

                        {candidateItem && (
                            <div className="p-4 bg-indigo-50 border-t border-indigo-100 flex items-center justify-between">
                                <div>
                                    <p className="text-sm font-bold text-indigo-900 mb-1">Confirmar Qtd. (Máx: {parseFloat(candidateItem.qtd_faturar)})</p>

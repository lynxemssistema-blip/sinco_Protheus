        const serverUrl = process.env.APP_URL || 'http://192.168.1.77:3000';

        for (const user of users) {
            if (!user.email) {
                results.failed.push({ id: user.idUsuario, nome: user.NomeCompleto, reason: 'Sem e-mail cadastrado' });

                    SET peso_kg = ?,
                        area_pintura_m2 = ?,
                        extraido_em = CURRENT_TIMESTAMP,
                        extraido_por = 'manual_batch_review'
                    WHERE id = ?
                `, [
                    peso_kg,
                    area_pintura_m2,
                    item.documento_id
                ]);
                updatedCount++;
            } catch (itemErr) {
                console.error(`Erro ao salvar metadados para doc ${item.documento_id}:`, itemErr);
                errorCount++;

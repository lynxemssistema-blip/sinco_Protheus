    const example = [
        ['53277', '27.04.00389', 'SCANNER SPECTRUM 180180', '21.23.04497', 'SUPORTE FONTE WEG / AA_10055_02', 1, 0, 2],
        ['53278', '27.04.00390', 'SCANNER SPECTRUM 320KV',  '21.23.04498', 'TAMPA FONTE WEG / AA_10056_00',  0, 3, 0],
    ];

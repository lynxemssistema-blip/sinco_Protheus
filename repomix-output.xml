                                                                className="px-2 py-1 bg-red-50 text-red-600 border border-red-200 rounded text-[11px] font-medium hover:bg-red-100 hover:border-red-400 transition-colors flex items-center gap-1">
                                                                <Link2Off className="w-3 h-3" /> Desvincular
                                                            </button>

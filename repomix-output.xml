        if (editingProcess) {
            // Edit existing
            setProcesses(prev => prev.map(p =>
                p.id === editingProcess.id ? { ...processData, id: editingProcess.id } : p
            ));
        } else {
            // Create new
            setProcesses(prev => [...prev, { ...processData, id: prev.length + 1 }]);

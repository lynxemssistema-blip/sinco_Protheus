# server/scripts/extract_docs.py
import os
import json
import re
import win32com.client

def extract_data_from_doc(filepath, word_app):
    doc = word_app.Documents.Open(filepath, ReadOnly=True)
    text = doc.Range().Text
    doc.Close()
    
    # Defaults
    cargo = {"denominacao": os.path.basename(filepath).replace('.doc', '').strip(), "codigo_interno": "", "cbo": "", "atividades": []}
    
    try:
        lines = [line.strip() for line in text.split('\r') if line.strip()]
        
        # VERY basic heuristic parser for typical SGQ Cargos Document
        for i, line in enumerate(lines):
            # Extract CBO
            if "CBO:" in line:
                m = re.search(r'CBO:\s*([\d-]+)', line)
                if m:
                    cargo["cbo"] = m.group(1)
            
            # Extract Codigo
            if "CÓDIGO:" in line or "CODIGO:" in line or "CDIGO:" in line:
                m = re.search(r'C[ÓO]DIGO:\s*([A-Za-z0-9_-]+)', line)
                if m:
                    cargo["codigo_interno"] = m.group(1)
                    
            # Extract Activities (looking for numbered lines like '01', '02')
            if re.match(r'^\d{2}\s+', line):
                activity = re.sub(r'^\d{2}\s+', '', line).strip()
                cargo["atividades"].append(activity)

    except Exception as e:
        print(f"Error parsing {filepath}: {e}")
        
    return cargo

def main():
    folder = r"C:\Users\adm\Desktop\MetalFisa Anty\Cargo e Funções"
    output_file = r"C:\Users\adm\Desktop\MetalFisa Anty\server\scripts\cargos.json"
    
    if not os.path.exists(folder):
        print("Folder not found.")
        return

    word = win32com.client.Dispatch("Word.Application")
    word.Visible = False
    
    cargos = []
    
    files = [f for f in os.listdir(folder) if f.lower().endswith('.doc')]
    
    for i, file in enumerate(files):
        filepath = os.path.join(folder, file)
        print(f"Processing {i+1}/{len(files)}: {file}")
        data = extract_data_from_doc(filepath, word)
        cargos.append(data)
        
    word.Quit()
    
    with open(output_file, 'w', encoding='utf-8') as f:
        json.dump(cargos, f, ensure_ascii=False, indent=2)
        
    print(f"Extraction complete. Saved {len(cargos)} records to {output_file}")

if __name__ == "__main__":
    main()
</file>

<file path="server/scripts/extract_protheus_sqls.js">
const fs = require('fs');
const path = require('path');
const db = require('../services/mysqlService');

const TARGET_DIRS = [
    path.join(__dirname, '..', 'routes'),
    path.join(__dirname, '..', 'services')
];

// Padrões de tabelas do Protheus comuns na MetalFisa
// SC2, SC5, SC6, SB1, SCJ, SF2, SD3, SD1, SG1, SG2, etc.
const TABLE_PATTERN = /\b(SC[1-9]|SB[0-9]|SD[1-9]|SF[1-9]|SG[1-9]|SH[1-9]|SZ[0-9])010\b/i;
// Regex muito básica para pegar blocos com SELECT/UPDATE/INSERT seguido por tabelas de 6 chars.
// Vamos extrair todas as chamadas db.query( ... ) ou const query = \`...\`;
const QUERY_REGEX = /(?:db\.query\s*\(\s*|const\s+\w+\s*=\s*)([`'"])([\s\S]*?)(SELECT|UPDATE|INSERT|DELETE|EXEC)[\s\S]*?\1/gi;

async function extractSqls() {
    let extractedCount = 0;

    for (const dir of TARGET_DIRS) {
        if (!fs.existsSync(dir)) continue;

        const files = fs.readdirSync(dir).filter(f => f.endsWith('.js'));
        for (const file of files) {
            const filePath = path.join(dir, file);
            const content = fs.readFileSync(filePath, 'utf-8');

            // Find all backtick/quote strings that have SQL keywords
            let match;
            while ((match = QUERY_REGEX.exec(content)) !== null) {
                const fullString = match[2] + match[3] + content.slice(match.index + match[0].length).split(match[1])[0];
                
                // Extra verification: does it actually look like a protheus query? (mentions SC2010, SB1010...)
                if (TABLE_PATTERN.test(fullString) && fullString.trim().length > 20) {
                    const cleanSql = fullString.trim();
                    const relativePath = path.relative(path.join(__dirname, '..'), filePath).replace(/\\/g, '/');
                    
                    try {
                        await db.execute(
                            `INSERT INTO app_protheus_query_catalog (file_source, sql_content, description) VALUES (?, ?, ?)`,
                            [relativePath, cleanSql, 'Extraído automaticamente do código fonte Backend Node.js.']
                        );
                        extractedCount++;
                    } catch (e) {
                        console.error('Erro salvando sql de', relativePath, e.message);
                    }
                }
            }
        }
    }

    console.log(`✅ Extração concluída! Foram mapeadas e extraídas ${extractedCount} consultas no banco de dados Protheus.`);
    process.exit(0);
}

extractSqls().catch(e => {
    console.error('Falha geral:', e);
    process.exit(1);
});

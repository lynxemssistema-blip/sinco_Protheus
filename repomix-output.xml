                                placeholder="000123"
                            />
                        </div>

                        {/* Código Produto */}
                        <div>
                            <label className="block text-xs font-medium text-slate-600 mb-1">Cód. Produto</label>
                            <input
                                type="text"
                                value={filters.produto}
